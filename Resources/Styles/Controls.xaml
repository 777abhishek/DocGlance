<?xml version="1.0" encoding="utf-8"?>
<!-- Shared control styles (flat icon buttons, sidebar tabs, overlay pill).
     Mirrors Rune/src/Rune.App/Styles/Controls.xaml conventions. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flat icon button -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width"           Value="36"/>
        <Setter Property="Height"          Value="36"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
    </Style>

    <!-- Flat icon toggle button -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width"           Value="36"/>
        <Setter Property="Height"          Value="36"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
    </Style>

    <!-- Sidebar tab segment -->
    <Style x:Key="SidebarTabStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height"          Value="34"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
    </Style>

    <!-- Floating acrylic pill (zoom + find bar) -->
    <Style x:Key="OverlayPillStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="12"/>
    </Style>

</ResourceDictionary>
