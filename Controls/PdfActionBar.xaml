<UserControl
    x:Class="QuickView.Controls.PdfActionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Height="48"
        Padding="8,0"
        ColumnSpacing="2"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Page Navigation -->
        <StackPanel
            Grid.Column="0"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">
            <NumberBox
                x:Name="PageBox"
                AutomationProperties.Name="Page number"
                Minimum="1"
                SpinButtonPlacementMode="Hidden"
                MinWidth="60"
                VerticalAlignment="Center"
                ValueChanged="PageBox_ValueChanged" />
            <TextBlock
                x:Name="PageCountLabel"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border 
            Grid.Column="1" 
            Width="1" 
            Height="24" 
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Margin="8,0,4,0" />

        <!-- Zoom Controls -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Center">
            <Button
                x:Name="ZoomOutButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="ZoomOutButton_Click"
                ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                <FontIcon Glyph="&#xE738;" FontSize="16" />
            </Button>
            <Button
                x:Name="ZoomLevelButton"
                MinWidth="60"
                Height="36"
                Padding="8,0"
                Background="Transparent"
                BorderThickness="1"
                Click="ZoomLevelButton_Click"
                ToolTipService.ToolTip="Zoom level">
                <TextBlock x:Name="ZoomLabel" Text="100%" />
            </Button>
            <Button
                x:Name="ZoomInButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="ZoomInButton_Click"
                ToolTipService.ToolTip="Zoom in (Ctrl++)">
                <FontIcon Glyph="&#xE710;" FontSize="16" />
            </Button>
        </StackPanel>

        <Border 
            Grid.Column="3" 
            Width="1" 
            Height="24" 
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Margin="8,0,4,0" />

        <!-- Rotate & Fit Controls -->
        <StackPanel
            Grid.Column="4"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Center">
            <Button
                x:Name="FitWidthButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="FitWidthButton_Click"
                ToolTipService.ToolTip="Fit width">
                <FontIcon Glyph="&#xE9A6;" FontSize="16" />
            </Button>
            <Button
                x:Name="RotateButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="RotateButton_Click"
                ToolTipService.ToolTip="Rotate right (Ctrl+R)">
                <FontIcon Glyph="&#xE7AD;" FontSize="16" />
            </Button>
        </StackPanel>

        <!-- Right Side Actions -->
        <StackPanel
            Grid.Column="6"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Center">
            <Button
                x:Name="SearchButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="SearchButton_Click"
                ToolTipService.ToolTip="Search (Ctrl+F)">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
            </Button>
            <Button
                x:Name="PrintButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="PrintButton_Click"
                ToolTipService.ToolTip="Print (Ctrl+P)">
                <FontIcon Glyph="&#xE749;" FontSize="16" />
            </Button>
        </StackPanel>

        <Border 
            Grid.Column="7" 
            Width="1" 
            Height="24" 
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Margin="8,0,4,0" />

        <Button
            x:Name="MoreButton"
            Grid.Column="8"
            Width="36"
            Height="36"
            Padding="0"
            ToolTipService.ToolTip="More options">
            <FontIcon Glyph="&#xE712;" FontSize="16" />
            <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem Text="Save as..." Click="SaveAsMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE792;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Document properties" Click="PropertiesMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Settings" Click="SettingsMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
