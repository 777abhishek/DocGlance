<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickView.Controls.DocumentCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ContextButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="#44000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="14"/>
        </Style>
    </UserControl.Resources>

    <!--
        The entire card is a single Button using the built-in WinUI
        TransparentButtonStyle — this guarantees hit-testing works
        everywhere because the Button's Grid background is set to a
        nearly-invisible colour (not Transparent = no hit-test).

        The three-dot context menu Button sits in the same Grid with
        a higher ZIndex so its clicks don't reach the card Button.
    -->
    <Button
        x:Name="CardButton"
        Padding="0"
        BorderThickness="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Background="Transparent"
        Click="CardButton_Click"
        ToolTipService.ToolTip="Open document">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid Background="{TemplateBinding Background}">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
                </Grid>
            </ControlTemplate>
        </Button.Template>

        <!-- Outer card grid — fixed size scaled by Viewbox -->
        <Grid>

            <!-- Invisible hit-test rectangle — covers the FULL card area.
                 WinUI treats Alpha=1 as hittable even though it's invisible. -->
            <Rectangle Fill="#01000000" IsHitTestVisible="True"/>

            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid Width="280" Height="200">

                    <Border CornerRadius="16" BorderThickness="1" BorderBrush="#18FFFFFF">
                        <Grid>

                            <!-- Gradient background -->
                            <Border CornerRadius="15,15,0,0">
                                <Grid>
                                    <Rectangle x:Name="PreviewBackground">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="GradientStart" Offset="0" Color="#FFDC3545"/>
                                                <GradientStop x:Name="GradientEnd"   Offset="1" Color="#FFF0505F"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Image x:Name="ThumbnailImage"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Visibility="Collapsed"/>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.0" Color="#00000000"/>
                                                <GradientStop Offset="0.6" Color="#15000000"/>
                                                <GradientStop Offset="1.0" Color="#55000000"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- File type icon -->
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="#28FFFFFF"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="14,14,0,0">
                                <FontIcon x:Name="FileTypeIcon"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="22" Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="ExtensionText" Visibility="Collapsed"/>

                            <!-- Dark curved info panel -->
                            <Grid Height="100" VerticalAlignment="Bottom">
                                <Path x:Name="InfoPanelShape"
                                      Fill="#E6202020"
                                      Stretch="Fill"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,28" IsClosed="True">
                                                <LineSegment Point="0,82"/>
                                                <QuadraticBezierSegment Point1="0,100"   Point2="16,100"/>
                                                <LineSegment Point="264,100"/>
                                                <QuadraticBezierSegment Point1="280,100" Point2="280,82"/>
                                                <LineSegment Point="280,35"/>
                                                <BezierSegment Point1="255,35" Point2="230,33" Point3="205,27"/>
                                                <BezierSegment Point1="180,21" Point2="150,14" Point3="120,12"/>
                                                <LineSegment Point="16,12"/>
                                                <QuadraticBezierSegment Point1="0,12" Point2="0,28"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                            </Grid>

                            <!-- Text content -->
                            <Grid Margin="16,0,16,10" VerticalAlignment="Bottom">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FileNameText" Grid.Row="0"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FileTypeDesc" Grid.Column="0"
                                               FontSize="13" Foreground="#CCF0F0F0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE787;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="12" Foreground="#99FFFFFF"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ModifiedText"
                                                   FontSize="13" Foreground="#99FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="FileSizeText" Grid.Row="3"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E6FFFFFF"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
                            </Grid>

                        </Grid>
                    </Border>

                </Grid>
            </Viewbox>

            <!-- Three-dot context menu — above the card button in z-order -->
            <Button
                x:Name="ContextMenuButton"
                Style="{StaticResource ContextButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Canvas.ZIndex="10"
                ToolTipService.ToolTip="More options">
                <FontIcon Glyph="&#xE712;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="14" Foreground="White"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Open" Click="OpenMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <ToggleMenuFlyoutItem x:Name="BookmarkToggle"
                                              Text="Bookmark"
                                              Click="BookmarkMenuItem_Click">
                            <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;"/></ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutItem Text="Show in File Explorer"
                                        Click="ShowInExplorerMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Share" Click="ShareMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem Text="Open with">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7AC;"/></MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Default app"
                                            Click="OpenWithDefaultMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Choose another app..."
                                            Click="OpenWithChooseMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE712;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>
    </Button>

</UserControl>
