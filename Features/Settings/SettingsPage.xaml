<Page
    x:Class="DocGlance.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Section title (Appearance, Viewer, ...) -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,24,0,8" />
        </Style>

        <!-- One setting row: icon | title + description | control -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18,14,18,14" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SettingIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,36,48,40" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ═════════════ LEFT: settings ═════════════ -->
            <StackPanel Grid.Column="0" Spacing="6" MaxWidth="1000" HorizontalAlignment="Stretch">

                <!-- ───────── Appearance ───────── -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" Margin="2,0,0,8" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="App theme" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Select light or dark mode" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox" Grid.Column="2" MinWidth="200"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Use system setting" Tag="Default" IsSelected="True" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border x:Name="PaletteCard" Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE771;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Color palette" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Choose color scheme variant for selected theme" />
                        </StackPanel>
                        <ComboBox x:Name="PaletteComboBox" Grid.Column="2" MinWidth="200"
                                  VerticalAlignment="Center"
                                  SelectionChanged="PaletteComboBox_SelectionChanged">
                            <ComboBoxItem Content="Midnight (Default)" Tag="Midnight" IsSelected="True" />
                            <ComboBoxItem Content="Paper" Tag="Paper" />
                            <ComboBoxItem Content="Forest" Tag="Forest" />
                            <ComboBoxItem Content="Violet" Tag="Violet" />
                            <ComboBoxItem Content="Ember" Tag="Ember" />
                            <ComboBoxItem Content="Rose" Tag="Rose" />
                            <ComboBoxItem Content="Nord" Tag="Nord" />
                            <ComboBoxItem Content="Gruvbox" Tag="Gruvbox" />
                            <ComboBoxItem Content="Snow" Tag="Snow" />
                            <ComboBoxItem Content="Ocean" Tag="Ocean" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ───────── Viewer ───────── -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Viewer" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE740;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Default view mode" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="How pages are fitted in the window" />
                        </StackPanel>
                        <ComboBox x:Name="ViewModeComboBox" Grid.Column="2" MinWidth="160" 
                                  VerticalAlignment="Center" SelectedIndex="0"
                                  SelectionChanged="ViewModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Fit to width" />
                            <ComboBoxItem Content="Fit to page" />
                            <ComboBoxItem Content="Actual size" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8A3;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Default zoom level" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Initial zoom percentage when opening documents" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="ZoomSlider" Width="180"
                                    Minimum="50" Maximum="200" StepFrequency="10"
                                    TickFrequency="50" TickPlacement="None" Value="100"
                                    ValueChanged="ZoomSlider_ValueChanged" />
                            <TextBlock x:Name="ZoomValueText" Text="100%" Width="45" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE721;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Global file-open shortcut" />
                                <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                           Text="Select a supported file in File Explorer and press the shortcut to open it in a DocGlance tab. Registration is system-wide while DocGlance is running." />
                            </StackPanel>
                            <ToggleSwitch x:Name="QuickLookSpaceToggle" Grid.Column="2" IsOn="True"
                                          OnContent="On" OffContent="Off"
                                          VerticalAlignment="Center" MinWidth="0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Shortcut:" VerticalAlignment="Center" />
                            <TextBlock x:Name="QuickLookHotkeyText" Text="Ctrl + Shift + Space"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="ChangeQuickLookHotkeyButton" Content="Change shortcut"
                                    Click="ChangeQuickLookHotkeyButton_Click" />
                            <TextBox x:Name="QuickLookHotkeyCaptureBox" Width="220" IsReadOnly="True"
                                     PlaceholderText="Press a key combination…" Visibility="Collapsed"
                                     PreviewKeyDown="QuickLookHotkeyCaptureBox_PreviewKeyDown" />
                        </StackPanel>
                        <TextBlock x:Name="QuickLookHotkeyStatusText"
                                   Style="{StaticResource SettingDescriptionStyle}"
                                   Text="Checking global shortcut registration…" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                   Text="This shortcut is registered system-wide and may intercept the same key combination in other apps. Choose a combination you do not rely on elsewhere; Windows-key shortcuts are reserved." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B9;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Show page thumbnails" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Display thumbnail strip in PDF viewer" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ThumbnailsToggle" Grid.Column="2" IsOn="True"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" MinWidth="0"
                                      Toggled="ThumbnailsToggle_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C3;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Show sidebar" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Display document navigation sidebar by default" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SidebarToggle" Grid.Column="2" IsOn="True"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" MinWidth="0"
                                      Toggled="SidebarToggle_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE81C;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Remember view state" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Restore last view mode, zoom, and position for each file" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RememberViewToggle" Grid.Column="2" IsOn="True"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" MinWidth="0"
                                      Toggled="RememberViewToggle_Toggled" />
                    </Grid>
                </Border>

                <!-- ───────── Home & Browser ───────── -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Home &amp; Browser" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE80F;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Default home view" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Which tab to show when opening the Home page" />
                        </StackPanel>
                        <ComboBox x:Name="DefaultHomeViewComboBox" Grid.Column="2" MinWidth="160" 
                                  VerticalAlignment="Center" SelectedIndex="0"
                                  SelectionChanged="DefaultHomeViewComboBox_SelectionChanged">
                            <ComboBoxItem Content="Recent files" />
                            <ComboBoxItem Content="All files" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE81C;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Recent files limit" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Maximum number of recent files to track" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="RecentFilesSlider" Width="140"
                                    Minimum="10" Maximum="100" StepFrequency="5"
                                    TickFrequency="20" TickPlacement="None" Value="50"
                                    ValueChanged="RecentFilesSlider_ValueChanged" />
                            <TextBlock x:Name="RecentFilesValueText" Text="50" Width="30" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ───────── Session & Startup ───────── -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Session &amp; Startup" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7A8;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Restore last session" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Reopen tabs from your previous session on startup" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RestoreSessionToggle" Grid.Column="2" IsOn="True"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" MinWidth="0"
                                      Toggled="RestoreSessionToggle_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE737;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Restore window size" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Remember window size and position between sessions" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RestoreWindowToggle" Grid.Column="2" IsOn="True"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" MinWidth="0"
                                      Toggled="RestoreWindowToggle_Toggled" />
                    </Grid>
                </Border>

                <!-- ───────── Performance ───────── -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Performance" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE943;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Thumbnail cache size" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Maximum disk space for Home-page file thumbnails" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="CacheSizeSlider" Width="140"
                                    Minimum="100" Maximum="2000" StepFrequency="100"
                                    TickFrequency="500" TickPlacement="None" Value="500"
                                    ValueChanged="CacheSizeSlider_ValueChanged" />
                            <TextBlock x:Name="CacheSizeValueText" Text="500 MB" Width="60" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ───────── File associations ───────── -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="File associations" />

                <!-- Status + actions -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="AssocStatusIcon" Grid.Column="0" Glyph="&#xE73E;" FontSize="18"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Register all supported file types" />
                                <TextBlock x:Name="AssocStatusText"
                                           Style="{StaticResource SettingDescriptionStyle}"
                                           Text="Checking…" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                   Text="Registration adds DocGlance to 'Open with' for every supported extension. Windows does not let apps force themselves as the default; choose defaults per file type in Windows Settings → Default apps. Space Quick Look works only while DocGlance is open, not system-wide in File Explorer." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RegisterButton" Content="Register all file types"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="RegisterButton_Click" />
                            <Button x:Name="UnregisterButton" Content="Remove registration"
                                    Click="UnregisterButton_Click" />
                            <Button Content="Open Default Apps" Click="OpenDefaultApps_Click" />
                        </StackPanel>

                        <InfoBar x:Name="AssocInfoBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- Supported types -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          CornerRadius="6" Padding="18,12">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" MinHeight="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Supported file types" />
                                <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                           Text="Extensions DocGlance can preview" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <TextBlock x:Name="SupportedTypesText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="12" TextWrapping="Wrap" />
                </Expander>
            </StackPanel>

            <!-- ═════════════ RIGHT: About this app ═════════════ -->
            <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,0,0" VerticalAlignment="Top">

                <TextBlock Text="About this app" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,8" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                    <Image Source="ms-appx:///Assets/AppIconNew.png" Width="48" Height="48" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DocGlance" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Text="Version 1.0.0"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource SettingDescriptionStyle}" Margin="0,0,0,10"
                           Text="A fast, lightweight document viewer for Windows. Preview PDFs, Office files, code and text without opening heavy applications." />

                <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                           Text="© 2026 DocGlance Contributors. Licensed under the MIT License."
                           Margin="0,0,0,10" />

                <HyperlinkButton x:Name="GitHubLink" Padding="0,6" Click="GitHubLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock Text="View on GitHub" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton x:Name="ReleasesLink" Padding="0,6" Click="ReleasesLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="Check for updates" />
                    </StackPanel>
                </HyperlinkButton>

                <Button x:Name="IssuesLink" Margin="0,14,0,0" Padding="18,6"
                        Click="IssuesLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C9;" FontSize="14" />
                        <TextBlock Text="Report an issue" />
                    </StackPanel>
                </Button>

                <!-- ═════════════ Open Source Acknowledgments ═════════════ -->
                <TextBlock Text="Open source licenses" FontWeight="SemiBold" FontSize="14" Margin="2,24,0,8" />
                
                <TextBlock Style="{StaticResource SettingDescriptionStyle}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="DocGlance is built with these excellent open source libraries:" />

                <StackPanel Spacing="14">
                    <!-- Windows App SDK -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Windows App SDK" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
                            <Run Text="Version 2.4.0" />
                            <LineBreak />
                            <Run Text="MIT License • © Microsoft Corporation" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Win2D -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Win2D" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
                            <Run Text="Version 1.4.0" />
                            <LineBreak />
                            <Run Text="MIT License • © Microsoft Corporation" />
                        </TextBlock>
                    </StackPanel>

                    <!-- CommunityToolkit.Mvvm -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CommunityToolkit.Mvvm" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
                            <Run Text="Version 8.4.2" />
                            <LineBreak />
                            <Run Text="MIT License • © .NET Foundation" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Entity Framework Core -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Entity Framework Core (SQLite)" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
                            <Run Text="Version 8.0.11" />
                            <LineBreak />
                            <Run Text="MIT License • © .NET Foundation" />
                        </TextBlock>
                    </StackPanel>

                    <!-- FluentSystemIcons -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Fluent System Icons" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
                            <Run Text="Icon font for UI elements" />
                            <LineBreak />
                            <Run Text="MIT License • © Microsoft Corporation" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Rust Libraries (if using) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rust Native Libraries" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
                            <Run Text="pdfcraft_ffi, wordcraft_ffi, gridcraft_ffi, deckcraft_ffi" />
                            <LineBreak />
                            <Run Text="Document rendering engines" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <HyperlinkButton x:Name="ViewLicensesLink" Padding="0,8" Margin="0,8,0,0" Click="ViewLicensesLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        <TextBlock Text="View full license texts" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
