<Page
    x:Class="QuickView.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <Grid
            HorizontalAlignment="Stretch"
            Padding="28,22,28,32">
            <StackPanel Spacing="12">
            <!-- Header -->
            <TextBlock
                Margin="0,0,0,4"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Settings" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Tune QuickView to match the way you work." />

            <!-- Appearance Section -->
            <Border
                HorizontalAlignment="Stretch"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Appearance" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        HorizontalAlignment="Stretch"
                        Header="Theme"
                        SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Use system setting" IsSelected="True" />
                    </ComboBox>
                    <ToggleSwitch x:Name="MicaToggle" 
                                  Header="Enable Mica background" 
                                  IsOn="True"
                                  Toggled="MicaToggle_Toggled" />
                </StackPanel>
            </Border>

            <!-- Viewer Section -->
            <Border
                HorizontalAlignment="Stretch"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Viewer" />
                    <ToggleSwitch x:Name="ThumbnailsToggle" 
                                  Header="Show page thumbnails" 
                                  IsOn="True"
                                  Toggled="ThumbnailsToggle_Toggled" />
                    <Slider
                        HorizontalAlignment="Stretch"
                        Header="Default zoom level"
                        Maximum="200"
                        Minimum="50"
                        StepFrequency="25"
                        Value="100" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="Default view mode">
                        <ComboBoxItem Content="Fit to width" IsSelected="True" />
                        <ComboBoxItem Content="Fit to page" />
                        <ComboBoxItem Content="Actual size" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- File Associations Section -->
            <Border
                HorizontalAlignment="Stretch"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="File associations" />

                    <!-- Status row -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="AssocStatusIcon"
                                  Grid.Column="0"
                                  Glyph="&#xE73E;"
                                  FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="AssocStatusText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Checking…"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Description -->
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="When registered, QuickView appears in the 'Open with' menu for all supported file types. Individual defaults are set per file type in Windows Settings → Default apps." />

                    <!-- Supported types preview -->
                    <Expander HorizontalAlignment="Stretch" Header="Supported file types">
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            FontSize="12"
                            TextWrapping="Wrap"
                            x:Name="SupportedTypesText" />
                    </Expander>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RegisterButton"
                                Content="Register with Windows"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="RegisterButton_Click" />
                        <Button x:Name="UnregisterButton"
                                Content="Remove registration"
                                Click="UnregisterButton_Click" />
                        <Button Content="Open Default Apps"
                                Click="OpenDefaultApps_Click" />
                    </StackPanel>

                    <!-- Inline feedback -->
                    <InfoBar x:Name="AssocInfoBar"
                             IsOpen="False"
                             IsClosable="True" />
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border
                HorizontalAlignment="Stretch"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="About" />
                    
                    <!-- App Info with Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="8" 
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="28" 
                                     Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="QuickView"/>
                            <TextBlock x:Name="VersionText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Version 2026.09.28"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Description -->
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="A fast, lightweight document viewer for Windows. Preview PDFs, Office files, code, and text without opening heavy applications."
                        TextWrapping="Wrap"/>
                    
                    <!-- Features List -->
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Supported Formats" Margin="0,4,0,0"/>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" 
                                         Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="PDF with search, thumbnails, and bookmarks" 
                                          Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" 
                                         Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Office documents (DOCX, XLSX, PPTX)" 
                                          Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" 
                                         Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Code with syntax highlighting (C#, JS, Python, etc.)" 
                                          Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" 
                                         Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Markdown, HTML, CSV, JSON, XML, plain text" 
                                          Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Links -->
                    <StackPanel Spacing="8" Margin="0,6,0,0">
                        <HyperlinkButton x:Name="GitHubLink" 
                                        Click="GitHubLink_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="16"/>
                                <TextBlock Text="View on GitHub"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="IssuesLink"
                                        Click="IssuesLink_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C9;" FontSize="16"/>
                                <TextBlock Text="Report an issue"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="ReleasesLink"
                                        Click="ReleasesLink_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="16"/>
                                <TextBlock Text="Check for updates"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                    
                    <!-- Copyright -->
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="© 2026 QuickView Contributors. Licensed under the MIT License."
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
