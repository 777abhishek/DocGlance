<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickView.Features.Viewer.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickView.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <!-- Toolbar icon button -->
        <Style x:Key="IB" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Toolbar toggle button -->
        <Style x:Key="ITB" TargetType="ToggleButton">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Sidebar tab -->
        <Style x:Key="SidebarTabStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Floating overlay pill -->
        <Style x:Key="OverlayPillStyle" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
        </Style>

        <!-- Pill button -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── TOOLBAR ── slim, no borders, transparent background ── -->
        <Grid Grid.Row="0" Height="44" Padding="8,0" ColumnSpacing="2"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- sidebar toggle -->
                <ColumnDefinition Width="Auto"/>  <!-- page nav -->
                <ColumnDefinition Width="Auto"/>  <!-- fit buttons -->
                <ColumnDefinition Width="Auto"/>  <!-- rotate buttons -->
                <ColumnDefinition Width="*"/>     <!-- spacer -->
                <ColumnDefinition Width="Auto"/>  <!-- right actions -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar toggle -->
            <ToggleButton Grid.Column="0"
                x:Name="SidebarButton"
                Style="{StaticResource ITB}"
                IsChecked="True"
                Click="SidebarButton_Click"
                Margin="0,0,4,0"
                ToolTipService.ToolTip="Sidebar (F9)">
                <FontIcon Glyph="&#xE8A0;" FontSize="14"/>
            </ToggleButton>

            <!-- Page number: plain text, click to jump -->
            <StackPanel Grid.Column="1"
                Orientation="Horizontal" Spacing="4"
                VerticalAlignment="Center"
                Margin="8,0">
                <TextBlock
                    x:Name="PageNumberBox"
                    Text="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Tapped="PageNumber_Tapped"
                    ToolTipService.ToolTip="Click to go to page"/>
                <TextBlock
                    x:Name="TotalPagesText"
                    Text="/ 1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Fit buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                <ToggleButton x:Name="FitWidthButton"
                    Style="{StaticResource ITB}"
                    Click="FitWidthButton_Click"
                    ToolTipService.ToolTip="Fit width (Ctrl+2)">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="FitPageButton"
                    Style="{StaticResource ITB}"
                    Click="FitPageButton_Click"
                    ToolTipService.ToolTip="Fit page (Ctrl+0)">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform><RotateTransform Angle="90"/></FontIcon.RenderTransform>
                    </FontIcon>
                </ToggleButton>
            </StackPanel>

            <!-- Rotate buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
                <Button Style="{StaticResource IB}"
                    Click="RotateLeftButton_Click"
                    ToolTipService.ToolTip="Rotate left">
                    <FontIcon Glyph="&#xE7AD;" FontSize="14"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform><ScaleTransform ScaleX="-1"/></FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
                <Button Style="{StaticResource IB}"
                    Click="RotateRightButton_Click"
                    ToolTipService.ToolTip="Rotate right (Ctrl+R)">
                    <FontIcon Glyph="&#xE7AD;" FontSize="14"/>
                </Button>
            </StackPanel>

            <!-- Right actions -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                <!-- Text/Code editing tools (visible only for text/code files) -->
                <ToggleButton x:Name="WordWrapButton"
                    Style="{StaticResource ITB}"
                    Visibility="Collapsed"
                    Click="WordWrapButton_Click"
                    ToolTipService.ToolTip="Word wrap (Alt+Z)">
                    <FontIcon Glyph="&#xE8C1;" FontSize="14"/>
                </ToggleButton>
                <Button x:Name="SaveButton"
                    Style="{StaticResource IB}"
                    Visibility="Collapsed"
                    Click="SaveButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                </Button>
                <Button x:Name="SaveAsButton"
                    Style="{StaticResource IB}"
                    Visibility="Collapsed"
                    Click="SaveAsButton_Click"
                    ToolTipService.ToolTip="Save as... (Ctrl+Shift+S)">
                    <FontIcon Glyph="&#xE792;" FontSize="14"/>
                </Button>
                <Button x:Name="FindButton"
                    Style="{StaticResource IB}"
                    Click="FindButton_Click"
                    ToolTipService.ToolTip="Find (Ctrl+F)">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IB}"
                    Click="OpenExternalButton_Click"
                    ToolTipService.ToolTip="Open with default app">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IB}"
                    Click="ShowInExplorerButton_Click"
                    ToolTipService.ToolTip="Show in File Explorer">
                    <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                </Button>
                <!-- Document Info button -->
                <Button x:Name="DocInfoButton"
                    Style="{StaticResource IB}"
                    Click="DocInfoButton_Click"
                    ToolTipService.ToolTip="Document info (Ctrl+I)">
                    <FontIcon Glyph="&#xE946;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IB}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Document info" Click="DocInfoButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Presentation mode" Click="PresentationModeMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Print" Click="PrintMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Copy page text" Click="CopyPageTextMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Copy file path" Click="CopyPathMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Open with default app" Click="OpenExternalButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Show in File Explorer" Click="ShowInExplorerButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Bookmark this page" Click="BookmarkMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Settings" Click="SettingsMenuItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── BODY ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- MinWidth=0 so collapsing to 0 actually works -->
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Grid Grid.Column="0" x:Name="SidebarCard" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail list — tight padding -->
                <ListView Grid.Row="0"
                    x:Name="ThumbnailList"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="ThumbnailList_ItemClick"
                    Padding="4,4,4,4"
                    Background="Transparent"
                    KeyDown="DocumentScrollViewer_KeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PageThumbnailItem">
                            <StackPanel HorizontalAlignment="Center" Spacing="3" Padding="0,3">
                                <Grid Width="200" Height="{x:Bind BoxHeight, Mode=OneWay}">
                                    <Border CornerRadius="5" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <Border CornerRadius="5"
                                        BorderThickness="{x:Bind RingThickness, Mode=OneWay}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Text="{x:Bind PageLabel}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin"  Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Outline tree — items wrap long titles -->
                <TreeView x:Name="OutlineTree" Grid.Row="0"
                    Visibility="Collapsed" SelectionMode="Single"
                    Padding="2,2" Background="Transparent"
                    ItemInvoked="OutlineTree_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Margin="0,2"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- No-outline placeholder -->
                <TextBlock x:Name="NoOutlineLabel" Grid.Row="0"
                    Text="No table of contents" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <!-- No-bookmarks placeholder -->
                <StackPanel x:Name="NoBookmarksLabel" Grid.Row="0"
                    Spacing="4" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE718;" FontSize="24"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"/>
                    <TextBlock Text="No bookmarks yet" HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Bookmark a page from the menu" HorizontalAlignment="Center"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </StackPanel>

                <!-- Bookmark list -->
                <ListView x:Name="BookmarkList" Grid.Row="0"
                    Visibility="Collapsed"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="BookmarkList_ItemClick"
                    Padding="2,4" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,4" ColumnSpacing="6" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE718;"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PageDisplay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                    Tag="{Binding PageNumber}"
                                    Width="24" Height="24" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="5" VerticalAlignment="Center"
                                    Click="RemoveBookmark_Click"
                                    ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE74D;" FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin"  Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Tab switcher -->
                <Grid Grid.Row="1" Padding="4,3" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" x:Name="ThumbsTab"
                        Style="{StaticResource SidebarTabStyle}"
                        IsChecked="True" Click="ThumbsTab_Click"
                        ToolTipService.ToolTip="Thumbnails">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Grid.Column="1" x:Name="OutlineTab"
                        Style="{StaticResource SidebarTabStyle}"
                        Click="OutlineTab_Click"
                        ToolTipService.ToolTip="Chapters">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Grid.Column="2" x:Name="BookmarksTab"
                        Style="{StaticResource SidebarTabStyle}"
                        Click="BookmarksTab_Click"
                        ToolTipService.ToolTip="Bookmarks">
                        <FontIcon Glyph="&#xE8A4;" FontSize="14"/>
                    </ToggleButton>
                </Grid>
            </Grid>

            <!-- ── VIEWER CANVAS — takes full width when sidebar is collapsed ── -->
            <Grid Grid.Column="1" Background="Transparent">

                <ProgressRing x:Name="LoadingRing"
                    Width="48" Height="48"
                    IsActive="False" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Canvas.ZIndex="30"/>

                <ScrollViewer x:Name="DocumentScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Enabled"
                    MinZoomFactor="0.1" MaxZoomFactor="6.4"
                    Background="Transparent">
                    <!-- Minimal margin so pages use maximum available space -->
                    <StackPanel x:Name="PagesPanel"
                        Orientation="Vertical" Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="28,16"/>
                </ScrollViewer>

                <!-- ── TEXT viewer (plain) — TextBox IS the scroll host ── -->
                <!-- ── PLAIN TEXT viewer — TextBox is the scroll host ── -->
                <Grid x:Name="PlainTextViewerGrid"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LineNumberBlock"
                        Grid.Column="0"
                        FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                        FontSize="13"
                        LineHeight="22"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextAlignment="Right"
                        IsTextSelectionEnabled="False"
                        VerticalAlignment="Top"
                        Margin="16,20,12,16"/>

                    <!-- TextBox owns its own scrollbars — no outer ScrollViewer needed -->
                    <TextBox x:Name="PlainTextBlock"
                        Grid.Column="1"
                        FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                        FontSize="13"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0,16,24,16"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- ── CODE viewer — RichTextBlock in ScrollViewer ── -->
                <ScrollViewer x:Name="TextViewerScroll"
                    Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CodeLineNumberBlock"
                            Grid.Column="0"
                            FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                            FontSize="13"
                            LineHeight="22"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextAlignment="Right"
                            IsTextSelectionEnabled="False"
                            VerticalAlignment="Top"
                            Margin="16,16,12,16"/>

                        <RichTextBlock x:Name="TextViewerBlock"
                            Grid.Column="1"
                            FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                            FontSize="13"
                            LineHeight="22"
                            IsTextSelectionEnabled="True"
                            TextWrapping="NoWrap"
                            VerticalAlignment="Top"
                            Margin="0,16,24,16"/>
                    </Grid>
                </ScrollViewer>

                <!-- ── MARKDOWN viewer — rendered HTML in WebView2 ── -->
                <Grid x:Name="MarkdownViewerHost"
                    Visibility="Collapsed"
                    Padding="0"/>

                <Border x:Name="FindBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,10,0" Padding="8,5"
                    Style="{StaticResource OverlayPillStyle}"
                    Canvas.ZIndex="20">
                    <Border.Shadow><ThemeShadow/></Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBox x:Name="FindBox"
                            Width="220" PlaceholderText="Find in document"
                            KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"
                            CornerRadius="6"/>
                        <!-- Loading spinner: visible while search is running -->
                        <ProgressRing x:Name="FindSpinner"
                            Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"
                            VerticalAlignment="Center"/>
                        <TextBlock x:Name="FindCount"
                            VerticalAlignment="Center" MinWidth="44" Margin="2,0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <!-- Match-case toggle (Aa) -->
                        <ToggleButton x:Name="MatchCaseButton"
                            Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0"
                            Click="MatchCaseButton_Click"
                            ToolTipService.ToolTip="Match case (Alt+C)">
                            <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ToggleButton>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent"
                            Click="FindPrev_Click" ToolTipService.ToolTip="Previous (Shift+Enter)">
                            <FontIcon Glyph="&#xE70E;" FontSize="11"/>
                        </Button>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent"
                            Click="FindNext_Click" ToolTipService.ToolTip="Next (Enter)">
                            <FontIcon Glyph="&#xE70D;" FontSize="11"/>
                        </Button>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent"
                            Click="FindClose_Click" ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon Glyph="&#xE711;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Zoom pill -->
                <Border x:Name="ZoomPill"
                    Style="{StaticResource OverlayPillStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12" Height="44" Padding="4,0"
                    Canvas.ZIndex="20">
                    <Border.Shadow><ThemeShadow/></Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Style="{StaticResource PillButtonStyle}"
                            Click="ZoomOutButton_Click"
                            ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                            <FontIcon Glyph="&#xE738;" FontSize="13"/>
                        </Button>
                        <Button x:Name="ZoomLabelButton"
                            Background="Transparent" BorderThickness="0"
                            Height="36" MinWidth="54" Padding="4,0" CornerRadius="18"
                            ToolTipService.ToolTip="Zoom presets">
                            <TextBlock x:Name="ZoomLabel" Text="100%"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="50%"  Click="ZoomPreset_Click" Tag="0.5"/>
                                    <MenuFlyoutItem Text="75%"  Click="ZoomPreset_Click" Tag="0.75"/>
                                    <MenuFlyoutItem Text="100%" Click="ZoomPreset_Click" Tag="1.0"/>
                                    <MenuFlyoutItem Text="125%" Click="ZoomPreset_Click" Tag="1.25"/>
                                    <MenuFlyoutItem Text="150%" Click="ZoomPreset_Click" Tag="1.5"/>
                                    <MenuFlyoutItem Text="200%" Click="ZoomPreset_Click" Tag="2.0"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Fit width" Click="FitWidthButton_Click"/>
                                    <MenuFlyoutItem Text="Fit page"  Click="FitPageButton_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource PillButtonStyle}"
                            Click="ZoomInButton_Click"
                            ToolTipService.ToolTip="Zoom in (Ctrl++)">
                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Page>
