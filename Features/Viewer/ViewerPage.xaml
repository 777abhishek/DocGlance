<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DocGlance.Features.Viewer.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DocGlance.Core.Models"
    xmlns:components="using:DocGlance.Features.Viewer.Components"
    xmlns:pdf="using:DocGlance.Features.Viewer.Formats.Pdf"
    Background="Transparent"
>

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>

        <!-- Toolbar icon button -->
        <Style x:Key="IB" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Toolbar toggle button -->
        <Style x:Key="ITB" TargetType="ToggleButton">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Sidebar tab -->
        <Style x:Key="SidebarTabStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Floating overlay pill -->
        <Style x:Key="OverlayPillStyle" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
        </Style>

        <!-- Pill button -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

    </Page.Resources>

    <Grid x:Name="ViewerRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── TOOLBAR ── -->
        <components:ViewerToolbar Grid.Row="0" x:Name="Toolbar"
            SidebarToggled="Toolbar_SidebarToggled"
            FitWidthRequested="Toolbar_FitWidthRequested"
            FitPageRequested="Toolbar_FitPageRequested"
            RotateRequested="Toolbar_RotateRequested"
            FindRequested="Toolbar_FindRequested"
            OpenExternalRequested="OpenExternalButton_Click"
            ShowInExplorerRequested="ShowInExplorerButton_Click"
            DocInfoRequested="DocInfoButton_Click"
            PresentationModeRequested="PresentationModeMenuItem_Click"
            KeyboardShortcutsRequested="ShowKeyboardShortcuts"
            PrintRequested="PrintMenuItem_Click"
            CopyPageTextRequested="CopyPageTextMenuItem_Click"
            CopyPathRequested="CopyPathMenuItem_Click"
            BookmarkRequested="BookmarkMenuItem_Click"
            SettingsRequested="SettingsMenuItem_Click"
            WordWrapRequested="WordWrapButton_Click"
            MarkupSettingsChanged="Toolbar_MarkupSettingsChanged"
            UndoAnnotationRequested="Toolbar_UndoAnnotationRequested"
            RedoAnnotationRequested="Toolbar_RedoAnnotationRequested"
            GoToPageRequested="Toolbar_GoToPageRequested" />

        <!-- ── BODY ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- MinWidth=0 so collapsing to 0 actually works -->
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Grid Grid.Column="0" x:Name="SidebarCard" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail list — tight padding -->
                <ListView Grid.Row="0"
                    x:Name="ThumbnailList"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="ThumbnailList_ItemClick"
                    Padding="4,4,4,4"
                    Background="Transparent"
                    KeyDown="DocumentScrollViewer_KeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PageThumbnailItem">
                            <StackPanel HorizontalAlignment="Center" Spacing="3" Padding="0,3">
                                <Grid Width="200" Height="{x:Bind BoxHeight, Mode=OneWay}">
                                    <Border CornerRadius="5" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <Border CornerRadius="5"
                                        BorderThickness="{x:Bind RingThickness, Mode=OneWay}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Text="{x:Bind PageLabel}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin"  Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Outline tree — items wrap long titles -->
                <TreeView x:Name="OutlineTree" Grid.Row="0"
                    Visibility="Collapsed" SelectionMode="Single"
                    Padding="2,2" Background="Transparent"
                    ItemInvoked="OutlineTree_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Margin="0,2"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- No-outline placeholder -->
                <TextBlock x:Name="NoOutlineLabel" Grid.Row="0"
                    Text="No table of contents" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <!-- No-bookmarks placeholder -->
                <StackPanel x:Name="NoBookmarksLabel" Grid.Row="0"
                    Spacing="4" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE718;" FontSize="24"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"/>
                    <TextBlock Text="No bookmarks yet" HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Bookmark a page from the menu" HorizontalAlignment="Center"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </StackPanel>

                <!-- Bookmark list -->
                <ListView x:Name="BookmarkList" Grid.Row="0"
                    Visibility="Collapsed"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="BookmarkList_ItemClick"
                    Padding="2,4" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,4" ColumnSpacing="6" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE718;"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PageDisplay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                    Tag="{Binding PageNumber}"
                                    Width="24" Height="24" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="5" VerticalAlignment="Center"
                                    Click="RemoveBookmark_Click"
                                    ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE74D;" FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin"  Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock x:Name="NoNotesLabel" Grid.Row="0"
                    Text="No notes in this document" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <ListView x:Name="NotesList" Grid.Row="0"
                    Visibility="Collapsed"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="NotesList_ItemClick"
                    Padding="2,4" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6,5" Spacing="3">
                                <TextBlock Text="{Binding PageDisplay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Contents}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    MaxLines="4"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Tab switcher -->
                <Grid Grid.Row="1" Padding="4,3" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" x:Name="ThumbsTab"
                        Style="{StaticResource SidebarTabStyle}"
                        IsChecked="True" Click="ThumbsTab_Click"
                        ToolTipService.ToolTip="Thumbnails">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Grid.Column="1" x:Name="OutlineTab"
                        Style="{StaticResource SidebarTabStyle}"
                        Click="OutlineTab_Click"
                        ToolTipService.ToolTip="Chapters">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Grid.Column="2" x:Name="BookmarksTab"
                        Style="{StaticResource SidebarTabStyle}"
                        Click="BookmarksTab_Click"
                        ToolTipService.ToolTip="Bookmarks">
                        <FontIcon Glyph="&#xE8A4;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Grid.Column="3" x:Name="NotesTab"
                        Style="{StaticResource SidebarTabStyle}"
                        Click="NotesTab_Click"
                        ToolTipService.ToolTip="Notes">
                        <FontIcon Glyph="&#xE70B;" FontSize="14"/>
                    </ToggleButton>
                </Grid>
            </Grid>

            <!-- ── VIEWER CANVAS — takes full width when sidebar is collapsed ── -->
            <Grid Grid.Column="1" Background="Transparent"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <pdf:PdfViewer x:Name="PdfViewerControl"/>

                <ContentControl
                    x:Name="UnsupportedFileMessage"
                    Visibility="Collapsed"/>

                <!-- Error message (same pattern as HomePage empty state) -->
                <StackPanel
                    x:Name="ErrorMessage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xEA39;"
                        FontSize="48"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.6"/>
                    <TextBlock
                        x:Name="ErrorMessageText"
                        Text="Error message"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ContentControl x:Name="TextViewerHost"
                    Visibility="Collapsed"/>

                <!-- ── SPREADSHEET viewer — native Win2D cell grid ── -->
                <ContentControl x:Name="SpreadsheetViewerHost"
                    Visibility="Collapsed"/>

                <Border x:Name="FindBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,10,0" Padding="8,5"
                    Style="{StaticResource OverlayPillStyle}"
                    Canvas.ZIndex="20">
                    <Border.Shadow><ThemeShadow/></Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBox x:Name="FindBox"
                            Width="220" PlaceholderText="Find in document"
                            KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"
                            CornerRadius="6"/>
                        <!-- Loading spinner: visible while search is running -->
                        <ProgressRing x:Name="FindSpinner"
                            Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"
                            VerticalAlignment="Center"/>
                        <TextBlock x:Name="FindCount"
                            VerticalAlignment="Center" MinWidth="44" Margin="2,0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <!-- Match-case toggle (Aa) -->
                        <ToggleButton x:Name="MatchCaseButton"
                            Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0"
                            Click="MatchCaseButton_Click"
                            ToolTipService.ToolTip="Match case">
                            <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ToggleButton>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent"
                            Click="FindPrev_Click" ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE70E;" FontSize="11"/>
                        </Button>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent"
                            Click="FindNext_Click" ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE70D;" FontSize="11"/>
                        </Button>
                        <Button Width="30" Height="30" Padding="0" CornerRadius="6"
                            Background="Transparent"
                            Click="FindClose_Click" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Zoom pill -->
                <Border x:Name="ZoomPill"
                    Style="{StaticResource OverlayPillStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12" Height="44" Padding="4,0"
                    Canvas.ZIndex="20">
                    <Border.Shadow><ThemeShadow/></Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Style="{StaticResource PillButtonStyle}"
                            Click="ZoomOutButton_Click"
                            ToolTipService.ToolTip="Zoom out">
                            <FontIcon Glyph="&#xE738;" FontSize="13"/>
                        </Button>
                        <Button x:Name="ZoomLabelButton"
                            Background="Transparent" BorderThickness="0"
                            Height="36" MinWidth="54" Padding="4,0" CornerRadius="18"
                            ToolTipService.ToolTip="Zoom presets">
                            <TextBlock x:Name="ZoomLabel" Text="100%"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="50%"  Click="ZoomPreset_Click" Tag="0.5"/>
                                    <MenuFlyoutItem Text="75%"  Click="ZoomPreset_Click" Tag="0.75"/>
                                    <MenuFlyoutItem Text="100%" Click="ZoomPreset_Click" Tag="1.0"/>
                                    <MenuFlyoutItem Text="125%" Click="ZoomPreset_Click" Tag="1.25"/>
                                    <MenuFlyoutItem Text="150%" Click="ZoomPreset_Click" Tag="1.5"/>
                                    <MenuFlyoutItem Text="200%" Click="ZoomPreset_Click" Tag="2.0"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Fit width" Click="ZoomFitWidth_Click"/>
                                    <MenuFlyoutItem Text="Fit page"  Click="ZoomFitPage_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource PillButtonStyle}"
                            Click="ZoomInButton_Click"
                            ToolTipService.ToolTip="Zoom in">
                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- ── LOADING INDICATOR (overlay) ── -->
        <Grid x:Name="LoadingOverlay"
              Grid.Row="1"
              Background="Transparent"
              Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="LoadingText"
                           Text="Loading document..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
