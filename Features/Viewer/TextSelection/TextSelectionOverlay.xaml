<Canvas x:Class="QuickView.Features.Viewer.TextSelection.TextSelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        IsHitTestVisible="True"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        PointerCanceled="OnPointerCanceled"
        RightTapped="OnRightTapped">
    
    <!-- Drag preview rectangle (visible during mouse drag) -->
    <Rectangle x:Name="DragRectangle"
               Visibility="Collapsed"
               Fill="#2052A4DE"
               Stroke="#8052A4DE"
               StrokeThickness="1"
               RadiusX="2"
               RadiusY="2"/>
    
    <!-- Context menu for Copy command -->
    <Canvas.ContextFlyout>
        <MenuFlyout x:Name="SelectionMenu"
                    Placement="Bottom">
            <MenuFlyoutItem Text="Copy"
                           Click="OnCopyClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Canvas.ContextFlyout>
</Canvas>
