<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocGlance.Features.Viewer.Components.PdfMarkupToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/Viewer/Components/ViewerToolbarIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MarkupToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MarkupButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        x:Name="PdfMarkupTools"
        Orientation="Horizontal"
        Spacing="2"
        HorizontalAlignment="Center"
        Visibility="Collapsed">

        <ToggleButton
            x:Name="PenToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="PenToolButton_Click"
            ToolTipService.ToolTip="Freehand pen">
            <FontIcon Glyph="{StaticResource ViewerIcon.Pen}" FontSize="16"/>
        </ToggleButton>

        <ToggleButton
            x:Name="MarkupToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="MarkupToolButton_Click"
            ToolTipService.ToolTip="Drag across text to highlight">
            <FontIcon Glyph="{StaticResource ViewerIcon.Markup}" FontSize="16"/>
        </ToggleButton>

        <ToggleButton
            x:Name="EraserToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="EraserToolButton_Click"
            ToolTipService.ToolTip="Erase annotations">
            <FontIcon Glyph="{StaticResource ViewerIcon.Eraser}" FontSize="16"/>
        </ToggleButton>

        <ToggleButton
            x:Name="NoteToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="NoteToolButton_Click"
            ToolTipService.ToolTip="Add a note">
            <FontIcon Glyph="{StaticResource ViewerIcon.Note}" FontSize="16"/>
        </ToggleButton>

        <ToggleButton
            x:Name="TextToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="TextToolButton_Click"
            ToolTipService.ToolTip="Add a text box">
            <FontIcon Glyph="{StaticResource ViewerIcon.Text}" FontSize="16"/>
        </ToggleButton>

        <ToggleButton
            x:Name="SignatureToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="SignatureToolButton_Click"
            ToolTipService.ToolTip="Draw a signature">
            <FontIcon Glyph="{StaticResource ViewerIcon.Signature}" FontSize="16"/>
        </ToggleButton>

        <ToggleButton
            x:Name="ImageToolButton"
            Style="{StaticResource MarkupToggleButtonStyle}"
            Click="ImageToolButton_Click"
            ToolTipService.ToolTip="Insert an image">
            <FontIcon Glyph="{StaticResource ViewerIcon.Image}" FontSize="16"/>
        </ToggleButton>

        <Button
            x:Name="UndoAnnotationButton"
            Style="{StaticResource MarkupButtonStyle}"
            Click="UndoAnnotationButton_Click"
            IsEnabled="False"
            ToolTipService.ToolTip="Undo annotation">
            <FontIcon Glyph="{StaticResource ViewerIcon.Undo}" FontSize="16"/>
        </Button>

        <Button
            x:Name="RedoAnnotationButton"
            Style="{StaticResource MarkupButtonStyle}"
            Click="RedoAnnotationButton_Click"
            IsEnabled="False"
            ToolTipService.ToolTip="Redo annotation">
            <FontIcon Glyph="{StaticResource ViewerIcon.Redo}" FontSize="16"/>
        </Button>

        <Button
            Style="{StaticResource MarkupButtonStyle}"
            ToolTipService.ToolTip="Markup settings">
            <FontIcon Glyph="{StaticResource ViewerIcon.MarkupSettings}" FontSize="16"/>
            <Button.Flyout>
                <Flyout Placement="Bottom">
                    <StackPanel Spacing="10" MinWidth="220" Padding="8">
                        <TextBlock Text="Markup style" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton
                                Content="Highlight"
                                IsChecked="True"
                                Tag="0"
                                Checked="MarkupStyle_Checked"/>
                            <RadioButton
                                Content="Underline"
                                Tag="1"
                                Checked="MarkupStyle_Checked"/>
                            <RadioButton
                                Content="Strikeout"
                                Tag="2"
                                Checked="MarkupStyle_Checked"/>
                        </StackPanel>
                        <TextBlock Text="Color" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Width="28" Height="28" Padding="0" Background="#FFFFDC28" Click="MarkupColor_Click" Tag="FFFFDC28" ToolTipService.ToolTip="Yellow"/>
                            <Button Width="28" Height="28" Padding="0" Background="#FFFF5C5C" Click="MarkupColor_Click" Tag="FFFF5C5C" ToolTipService.ToolTip="Red"/>
                            <Button Width="28" Height="28" Padding="0" Background="#FF52C7A5" Click="MarkupColor_Click" Tag="FF52C7A5" ToolTipService.ToolTip="Green"/>
                            <Button Width="28" Height="28" Padding="0" Background="#FF60A5FA" Click="MarkupColor_Click" Tag="FF60A5FA" ToolTipService.ToolTip="Blue"/>
                            <Button Width="28" Height="28" Padding="0" Background="#FFE879F9" Click="MarkupColor_Click" Tag="FFE879F9" ToolTipService.ToolTip="Pink"/>
                        </StackPanel>
                        <TextBlock Text="Opacity" FontWeight="SemiBold"/>
                        <Slider
                            x:Name="MarkupOpacitySlider"
                            Minimum="10"
                            Maximum="100"
                            Value="35"
                            StepFrequency="5"
                            ValueChanged="MarkupOpacitySlider_ValueChanged"/>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
