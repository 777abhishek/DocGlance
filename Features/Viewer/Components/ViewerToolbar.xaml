<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocGlance.Features.Viewer.Components.ViewerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:DocGlance.Features.Viewer.Components">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ToolbarBackground" ResourceKey="AppContentBackground"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ToolbarBackground" ResourceKey="AppContentBackground"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/Viewer/Components/ViewerToolbarIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="IB" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ITB" TargetType="ToggleButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Height="48"
          Padding="8,0"
          ColumnSpacing="2"
          Background="{ThemeResource ToolbarBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ToggleButton
            Grid.Column="0"
            x:Name="SidebarButton"
            Style="{StaticResource ITB}"
            IsChecked="True"
            Click="SidebarButton_Click"
            Margin="0,0,4,0"
            ToolTipService.ToolTip="Sidebar">
            <FontIcon
                FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                Glyph="{StaticResource ViewerIcon.Sidebar}"
                FontSize="16"/>
        </ToggleButton>

        <!-- Page counter -->
        <Border
            Grid.Column="1"
            Height="36"
            Padding="12,0"
            CornerRadius="6"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            VerticalAlignment="Center"
            Margin="4,0">

            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">

                <TextBlock
                    x:Name="PageNumberBox"
                    Text="1"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Tapped="PageNumber_Tapped"
                    ToolTipService.ToolTip="Click to go to page"/>

                <TextBlock
                    x:Name="TotalPagesText"
                    Text="/ 1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Fit controls -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="2"
            Margin="4,0,0,0">

            <ToggleButton
                x:Name="FitWidthButton"
                Style="{StaticResource ITB}"
                Click="FitWidthButton_Click"
                ToolTipService.ToolTip="Fit width">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.FitWidth}"
                    FontSize="16"/>
            </ToggleButton>

            <ToggleButton
                x:Name="FitPageButton"
                Style="{StaticResource ITB}"
                Click="FitPageButton_Click"
                ToolTipService.ToolTip="Fit page">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.FitPage}"
                    FontSize="16"/>
            </ToggleButton>
        </StackPanel>

        <!-- Rotation -->
        <StackPanel
            x:Name="RotationPanel"
            Grid.Column="3"
            Orientation="Horizontal"
            Spacing="2"
            Margin="4,0,0,0">

            <Button
                Style="{StaticResource IB}"
                Click="RotateLeftButton_Click"
                ToolTipService.ToolTip="Rotate left">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.RotateLeft}"
                    FontSize="16"/>
            </Button>

            <Button
                Style="{StaticResource IB}"
                Click="RotateRightButton_Click"
                ToolTipService.ToolTip="Rotate right">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.RotateRight}"
                    FontSize="16"/>
            </Button>
        </StackPanel>

        <!-- Right-side actions -->
        <components:PdfMarkupToolbar
            x:Name="PdfMarkupToolbar"
            Grid.Column="4"/>

        <!-- Right-side actions -->
        <StackPanel
            Grid.Column="5"
            Orientation="Horizontal"
            Spacing="2">

            <!-- Word wrap -->
            <ToggleButton
                x:Name="WordWrapButton"
                Style="{StaticResource ITB}"
                Visibility="Collapsed"
                Click="WordWrapButton_Click"
                ToolTipService.ToolTip="Word wrap">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.WordWrap}"
                    FontSize="16"/>
            </ToggleButton>

            <!-- Search -->
            <Button
                x:Name="FindButton"
                Style="{StaticResource IB}"
                Click="FindButton_Click"
                ToolTipService.ToolTip="Find">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.Find}"
                    FontSize="16"/>
            </Button>

            <!-- Open with -->
            <Button
                Style="{StaticResource IB}"
                Click="OpenExternalButton_Click"
                ToolTipService.ToolTip="Open with default app">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.OpenExternal}"
                    FontSize="16"/>
            </Button>

            <!-- Show in File Explorer -->
            <Button
                Style="{StaticResource IB}"
                Click="ShowInExplorerButton_Click"
                ToolTipService.ToolTip="Show in File Explorer">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.ShowInExplorer}"
                    FontSize="16"/>
            </Button>

            <!-- Document information -->
            <Button
                x:Name="DocInfoButton"
                Style="{StaticResource IB}"
                Click="DocInfoButton_Click"
                ToolTipService.ToolTip="Document info">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.DocumentInfo}"
                    FontSize="16"/>
            </Button>

            <!-- More options -->
            <Button
                Style="{StaticResource IB}"
                ToolTipService.ToolTip="More options">

                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="{StaticResource ViewerIcon.MoreOptions}"
                    FontSize="16"/>

                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">

                        <MenuFlyoutItem
                            Text="Document info"
                            Click="DocInfoButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                    Glyph="{StaticResource ViewerIcon.DocumentInfo}"
                                    FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Presentation mode"
                            ToolTipService.ToolTip="Presentation mode"
                            Click="PresentationModeMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.PresentationMode}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Bookmark this page"
                            Click="BookmarkMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.Bookmark}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem
                            Text="Print"
                            Click="PrintMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.Print}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Copy page text"
                            Click="CopyPageTextMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.CopyPageText}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Copy file path"
                            Click="CopyPathMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.CopyPath}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem
                            Text="Open with default app"
                            Click="OpenExternalButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                    Glyph="{StaticResource ViewerIcon.OpenExternal}"
                                    FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Show in File Explorer"
                            Click="ShowInExplorerButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                    Glyph="{StaticResource ViewerIcon.ShowInExplorer}"
                                    FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem
                            Text="Document tools"
                            Click="ToolsMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.Tools}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Settings"
                            Click="SettingsMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.Settings}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Keyboard shortcuts"
                            Click="KeyboardShortcutsMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{StaticResource ViewerIcon.KeyboardShortcuts}" FontSize="16"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
