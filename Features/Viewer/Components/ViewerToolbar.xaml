<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickView.Features.Viewer.Components.ViewerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="IB" TargetType="Button">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style x:Key="ITB" TargetType="ToggleButton">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>
    </UserControl.Resources>

    <Grid Height="48"
          Padding="8,0"
          ColumnSpacing="2"
          Background="Transparent">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ToggleButton
            Grid.Column="0"
            x:Name="SidebarButton"
            Style="{StaticResource ITB}"
            IsChecked="True"
            Click="SidebarButton_Click"
            Margin="0,0,4,0"
            ToolTipService.ToolTip="Sidebar (F9)">
            <FontIcon
                FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                Glyph="&#xF030F;"
                FontSize="20"/>
        </ToggleButton>

        <!-- Page counter -->
        <Border
            Grid.Column="1"
            Height="36"
            Padding="12,0"
            CornerRadius="6"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            VerticalAlignment="Center"
            Margin="4,0">

            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">

                <TextBlock
                    x:Name="PageNumberBox"
                    Text="1"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Tapped="PageNumber_Tapped"
                    ToolTipService.ToolTip="Click to go to page"/>

                <TextBlock
                    x:Name="TotalPagesText"
                    Text="/ 1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Fit controls -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="2"
            Margin="4,0,0,0">

            <ToggleButton
                x:Name="FitWidthButton"
                Style="{StaticResource ITB}"
                Click="FitWidthButton_Click"
                ToolTipService.ToolTip="Fit width (Ctrl+2)">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF590;"
                    FontSize="20"/>
            </ToggleButton>

            <ToggleButton
                x:Name="FitPageButton"
                Style="{StaticResource ITB}"
                Click="FitPageButton_Click"
                ToolTipService.ToolTip="Fit page (Ctrl+0)">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF54D;"
                    FontSize="20"/>
            </ToggleButton>
        </StackPanel>

        <!-- Rotation -->
        <StackPanel
            Grid.Column="3"
            Orientation="Horizontal"
            Spacing="2"
            Margin="4,0,0,0">

            <Button
                Style="{StaticResource IB}"
                Click="RotateLeftButton_Click"
                ToolTipService.ToolTip="Rotate left">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF186;"
                    FontSize="20"/>
            </Button>

            <Button
                Style="{StaticResource IB}"
                Click="RotateRightButton_Click"
                ToolTipService.ToolTip="Rotate right (Ctrl+R)">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF188;"
                    FontSize="20"/>
            </Button>
        </StackPanel>

        <!-- Right-side actions -->
        <StackPanel
            Grid.Column="5"
            Orientation="Horizontal"
            Spacing="2">

            <!-- Word wrap -->
            <ToggleButton
                x:Name="WordWrapButton"
                Style="{StaticResource ITB}"
                Visibility="Collapsed"
                Click="WordWrapButton_Click"
                ToolTipService.ToolTip="Word wrap (Alt+Z)">
                <FontIcon Glyph="&#xEF64;" FontSize="20"/>
            </ToggleButton>

            <!-- Search -->
            <Button
                x:Name="FindButton"
                Style="{StaticResource IB}"
                Click="FindButton_Click"
                ToolTipService.ToolTip="Find (Ctrl+F)">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF690;"
                    FontSize="20"/>
            </Button>

            <!-- Open with -->
            <Button
                Style="{StaticResource IB}"
                Click="OpenExternalButton_Click"
                ToolTipService.ToolTip="Open with default app">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF583;"
                    FontSize="20"/>
            </Button>

            <!-- Show in File Explorer -->
            <Button
                Style="{StaticResource IB}"
                Click="ShowInExplorerButton_Click"
                ToolTipService.ToolTip="Show in File Explorer">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF0C61;"
                    FontSize="20"/>
            </Button>

            <!-- Document information -->
            <Button
                x:Name="DocInfoButton"
                Style="{StaticResource IB}"
                Click="DocInfoButton_Click"
                ToolTipService.ToolTip="Document info (Ctrl+I)">
                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF4A4;"
                    FontSize="20"/>
            </Button>

            <!-- More options -->
            <Button
                Style="{StaticResource IB}"
                ToolTipService.ToolTip="More options">

                <FontIcon
                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    Glyph="&#xF557;"
                    FontSize="20"/>

                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">

                        <MenuFlyoutItem
                            Text="Document info"
                            Click="DocInfoButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                    Glyph="&#xF4A4;"
                                    FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>

                        <MenuFlyoutItem
                            Text="Presentation mode"
                            Click="PresentationModeMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE740;" FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>

                        <MenuFlyoutItem
                            Text="Print"
                            Click="PrintMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE749;" FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Copy page text"
                            Click="CopyPageTextMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Copy file path"
                            Click="CopyPathMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>

                        <MenuFlyoutItem
                            Text="Open with default app"
                            Click="OpenExternalButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                    Glyph="&#xF583;"
                                    FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            Text="Show in File Explorer"
                            Click="ShowInExplorerButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon
                                    FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                    Glyph="&#xF0C61;"
                                    FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>

                        <MenuFlyoutItem
                            Text="Bookmark this page"
                            Click="BookmarkMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE718;" FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator/>

                        <MenuFlyoutItem
                            Text="Settings"
                            Click="SettingsMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" FontSize="20"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
