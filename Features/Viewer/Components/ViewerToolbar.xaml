<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickView.Features.Viewer.Components.ViewerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Toolbar icon button -->
        <Style x:Key="IB" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <!-- Toolbar toggle button -->
        <Style x:Key="ITB" TargetType="ToggleButton">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Height="44" Padding="8,0" ColumnSpacing="2" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- sidebar toggle -->
            <ColumnDefinition Width="Auto"/>  <!-- page nav -->
            <ColumnDefinition Width="Auto"/>  <!-- fit buttons -->
            <ColumnDefinition Width="Auto"/>  <!-- rotate buttons -->
            <ColumnDefinition Width="*"/>     <!-- spacer & annotations -->
            <ColumnDefinition Width="Auto"/>  <!-- right actions -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar toggle -->
        <ToggleButton Grid.Column="0"
            x:Name="SidebarButton"
            Style="{StaticResource ITB}"
            IsChecked="True"
            Click="SidebarButton_Click"
            Margin="0,0,4,0"
            ToolTipService.ToolTip="Sidebar (F9)">
            <FontIcon Glyph="&#xF246;" FontSize="16"/>
        </ToggleButton>

        <!-- Page counter with proper vertical alignment -->
        <Border Grid.Column="1" 
                Height="32"
                Padding="12,0"
                CornerRadius="6"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                VerticalAlignment="Center"
                Margin="4,0">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="PageNumberBox" 
                           Text="1" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                           Tapped="PageNumber_Tapped" 
                           ToolTipService.ToolTip="Click to go to page"/>
                <TextBlock x:Name="TotalPagesText" 
                           Text="/ 1" 
                           VerticalAlignment="Center" 
                           FontSize="13" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Fit buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
            <ToggleButton x:Name="FitWidthButton" Style="{StaticResource ITB}" Click="FitWidthButton_Click" ToolTipService.ToolTip="Fit width (Ctrl+2)">
                <FontIcon Glyph="&#xF259;" FontSize="16"/>
            </ToggleButton>
            <ToggleButton x:Name="FitPageButton" Style="{StaticResource ITB}" Click="FitPageButton_Click" ToolTipService.ToolTip="Fit page (Ctrl+0)">
                <FontIcon Glyph="&#xF258;" FontSize="16"/>
            </ToggleButton>
        </StackPanel>

        <!-- Rotate buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
            <Button Style="{StaticResource IB}" Click="RotateLeftButton_Click" ToolTipService.ToolTip="Rotate left">
                <FontIcon Glyph="&#xE7A6;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource IB}" Click="RotateRightButton_Click" ToolTipService.ToolTip="Rotate right (Ctrl+R)">
                <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
            </Button>
        </StackPanel>

        <!-- Annotation tools: removed — editing is not implemented yet.
             Re-add here (column 4) when pen/highlighter/note/text/eraser land. -->

        <!-- Right actions -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="WordWrapButton" Style="{StaticResource ITB}" Visibility="Collapsed" Click="WordWrapButton_Click" ToolTipService.ToolTip="Word wrap (Alt+Z)">
                <FontIcon Glyph="&#xF2B9;" FontSize="16"/>
            </ToggleButton>
            <Button x:Name="FindButton" Style="{StaticResource IB}" Click="FindButton_Click" ToolTipService.ToolTip="Find (Ctrl+F)">
                <FontIcon Glyph="&#xE721;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource IB}" Click="OpenExternalButton_Click" ToolTipService.ToolTip="Open with default app">
                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource IB}" Click="ShowInExplorerButton_Click" ToolTipService.ToolTip="Show in File Explorer">
                <FontIcon Glyph="&#xE838;" FontSize="16"/>
            </Button>
            <Button x:Name="DocInfoButton" Style="{StaticResource IB}" Click="DocInfoButton_Click" ToolTipService.ToolTip="Document info (Ctrl+I)">
                <FontIcon Glyph="&#xE946;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource IB}" ToolTipService.ToolTip="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Document info" Click="DocInfoButton_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Presentation mode" Click="PresentationModeMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Print" Click="PrintMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy page text" Click="CopyPageTextMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy file path" Click="CopyPathMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Open with default app" Click="OpenExternalButton_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Show in File Explorer" Click="ShowInExplorerButton_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Bookmark this page" Click="BookmarkMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Settings" Click="SettingsMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
