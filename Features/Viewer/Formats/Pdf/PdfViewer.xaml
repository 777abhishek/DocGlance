<UserControl
    x:Class="DocGlance.Features.Viewer.Formats.Pdf.PdfViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <ScrollViewer x:Name="DocumentScrollViewer"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Enabled"
        MinZoomFactor="0.1" MaxZoomFactor="6.4"
        Background="Transparent">
        <Canvas x:Name="PdfViewportCanvas"
            Background="Transparent"
            Width="1000" Height="1400">
            <Image x:Name="ViewportImage"
                Stretch="Fill"
                Canvas.Left="0"
                Canvas.Top="0"/>
            <Canvas x:Name="SearchHighlightCanvas"
                IsHitTestVisible="False"/>
            <Canvas x:Name="PdfAnnotationCanvas"
                IsHitTestVisible="False"/>
            <Canvas x:Name="PdfSelectionCanvas"
                IsHitTestVisible="False"/>
        </Canvas>
    </ScrollViewer>
</UserControl>
