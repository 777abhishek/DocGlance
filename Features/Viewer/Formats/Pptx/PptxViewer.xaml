<UserControl
    x:Class="DocGlance.Features.Viewer.Formats.Pptx.PptxViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" x:Name="SidebarColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Slide thumbnails sidebar -->
        <Grid Grid.Column="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView x:Name="ThumbnailList"
                      ItemClick="ThumbnailList_ItemClick"
                      IsItemClickEnabled="True"
                      SelectionMode="Single"
                      Padding="8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6"
                                Padding="8"
                                Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <!-- Thumbnail image -->
                                <Border Height="100"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                <!-- Slide number -->
                                <TextBlock Text="{Binding Label}"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Main slide viewer -->
        <Grid Grid.Column="1">
            <!-- Slide display -->
            <ScrollViewer x:Name="SlideScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.5"
                          MaxZoomFactor="4.0"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Image x:Name="SlideImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </ScrollViewer>

            <!-- Page indicator overlay -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,8">
                <TextBlock x:Name="PageLabel"
                           Text="Slide 1 of 1"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Border>

            <!-- Loading indicator -->
            <ProgressRing x:Name="LoadingRing"
                          Width="48"
                          Height="48"
                          IsActive="True"
                          Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
