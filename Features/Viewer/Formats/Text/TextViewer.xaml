<UserControl
    x:Class="DocGlance.Features.Viewer.Formats.Text.TextViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid x:Name="PlainTextViewerGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LineNumberBlock"
            Grid.Column="0"
            FontFamily="Cascadia Code, Consolas, Courier New, monospace"
            FontSize="13"
            LineHeight="22"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextAlignment="Right"
            IsTextSelectionEnabled="False"
            VerticalAlignment="Top"
            Margin="16,20,12,16"/>

        <RichEditBox x:Name="PlainTextBlock"
            Grid.Column="1"
            FontFamily="Cascadia Code, Consolas, Courier New, monospace"
            FontSize="13"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            Background="Transparent"
            Padding="0,16,24,16"
            SelectionChanged="PlainTextBlock_SelectionChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            IsTabStop="True">
            <RichEditBox.Resources>
                <!-- Background colors - always transparent -->
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                
                <!-- Border colors - always transparent -->
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                
                <!-- Border thickness - zero to remove all borders including the blue bottom line -->
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </RichEditBox.Resources>
        </RichEditBox>
    </Grid>
</UserControl>
