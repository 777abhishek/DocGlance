<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocGlance.Features.Viewer.Formats.Rtf.RtfViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Main content area -->
        <RichEditBox x:Name="RichEditor"
                     IsReadOnly="True"
                     IsSpellCheckEnabled="False"
                     Padding="32,24,32,32"
                     Background="{ThemeResource AppContentBackground}"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     RequestedTheme="{Binding ElementName=RichEditor, Path=ActualTheme}"
                     BorderThickness="0"/>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed"
              Background="{ThemeResource AppContentBackground}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing Width="48" Height="48" IsActive="True"/>
                <TextBlock Text="Loading RTF document..."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Error overlay -->
        <Grid x:Name="ErrorOverlay" Visibility="Collapsed"
              Background="{ThemeResource AppContentBackground}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                        Spacing="16" MaxWidth="400" Padding="24">
                <FontIcon Glyph="&#xE783;" FontSize="48"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ErrorTitle" 
                           Text="RTF Not Supported"
                           FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="ErrorMessage"
                           Text="This RTF file cannot be displayed. RTF format support is limited in this viewer."
                           FontSize="14" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
