<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickView.Features.Tools.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR - Tool List -->
        <Border Grid.Column="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Padding="12">
                <TextBlock Text="DOCUMENT TOOLS" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="12,8,0,12"
                           CharacterSpacing="80"/>
                
                <ListView x:Name="ToolsList" 
                          SelectionMode="Single" 
                          SelectedIndex="0"
                          SelectionChanged="ToolsList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    
                    <!-- Word → PDF -->
                    <ListViewItem Tag="WordToPdf">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="#256EFF" VerticalAlignment="Center"/>
                            <TextBlock Text="Word → PDF" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    
                    <!-- PowerPoint → PDF -->
                    <ListViewItem Tag="PptToPdf">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" Foreground="#D24726" VerticalAlignment="Center"/>
                            <TextBlock Text="PowerPoint → PDF" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    
                    <!-- Excel → CSV -->
                    <ListViewItem Tag="ExcelToCsv">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xF1E8;" FontSize="16" Foreground="#217346" VerticalAlignment="Center"/>
                            <TextBlock Text="Excel → CSV" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- Info at bottom -->
                <StackPanel Spacing="6" Margin="12,24,12,12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="ArtCraft Libraries" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Native Rust performance with C# FFI interop." 
                               TextWrapping="Wrap" 
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Padding="32,24">
            
            <!-- Word → PDF -->
            <StackPanel x:Name="WordToPdfPanel" Spacing="20" MaxWidth="600" HorizontalAlignment="Left" Visibility="Visible">
                <TextBlock Text="Word → PDF" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Convert Word documents to PDF format using WordCraft." 
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                
                <StackPanel Spacing="16">
                    <!-- Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="WordInputPath" PlaceholderText="Select DOCX file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseWordInput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Output -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="WordOutputPath" PlaceholderText="PDF will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseWordOutput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Convert Button & Status -->
                    <StackPanel Spacing="12">
                        <Button x:Name="ConvertWordButton" Content="Convert to PDF" 
                                Click="ConvertWord_Click" 
                                IsEnabled="False"
                                Height="40"
                                Padding="24,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="WordProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="WordStatus" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- PowerPoint → PDF -->
            <StackPanel x:Name="PptToPdfPanel" Spacing="20" MaxWidth="600" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="PowerPoint → PDF" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Convert PowerPoint presentations to PDF format using DeckCraft." 
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                
                <StackPanel Spacing="16">
                    <!-- Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PptInputPath" PlaceholderText="Select PPTX file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePptInput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Output -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PptOutputPath" PlaceholderText="PDF will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePptOutput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Convert Button & Status -->
                    <StackPanel Spacing="12">
                        <Button x:Name="ConvertPptButton" Content="Convert to PDF" 
                                Click="ConvertPpt_Click" 
                                IsEnabled="False"
                                Height="40"
                                Padding="24,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="PptProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="PptStatus" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Excel → CSV -->
            <StackPanel x:Name="ExcelToCsvPanel" Spacing="20" MaxWidth="600" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="Excel → CSV" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Convert Excel spreadsheets to CSV format using GridCraft." 
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                
                <StackPanel Spacing="16">
                    <!-- Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ExcelInputPath" PlaceholderText="Select XLSX file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseExcelInput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Output -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ExcelOutputPath" PlaceholderText="CSV will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseExcelOutput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Convert Button & Status -->
                    <StackPanel Spacing="12">
                        <Button x:Name="ConvertExcelButton" Content="Convert to CSV" 
                                Click="ConvertExcel_Click" 
                                IsEnabled="False"
                                Height="40"
                                Padding="24,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="ExcelProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="ExcelStatus" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
