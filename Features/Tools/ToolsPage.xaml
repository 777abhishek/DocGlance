<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickView.Features.Tools.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickView.Features.Tools"
    Background="Transparent">

    <Page.Resources>
        <!-- Converter to show/hide based on null -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Segmented button style reused from HomePage for Split mode selector -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckedStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Transparent navigation rail, matching the rest of the app shell. -->
        <Border Grid.Column="0" Margin="10,10,0,10" Padding="8" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView x:Name="ToolsList" 
                          Grid.RowSpan="3"
                          SelectionMode="Single" 
                          SelectedIndex="0"
                          SelectionChanged="ToolsList_SelectionChanged">
                    <!-- Word → PDF -->
                    <ListViewItem Tag="WordToPdf">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF0C22;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Word → PDF" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="WordToPng">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF0C22;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Word → PNG" FontSize="14"/>
                        </StackPanel>
                    </ListViewItem>
                    
                    <!-- PowerPoint → PDF -->
                    <ListViewItem Tag="PptToPdf">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF12B;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="PowerPoint → PDF" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="PptToPng">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF12B;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="PowerPoint → PNG" FontSize="14"/>
                        </StackPanel>
                    </ListViewItem>
                    
                    <!-- Excel → CSV -->
                    <ListViewItem Tag="ExcelToCsv">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xE54C;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Excel → CSV" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="ExcelToPdf">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xE54C;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Excel → PDF" FontSize="14"/>
                        </StackPanel>
                    </ListViewItem>

                    <ListViewItem Tag="PdfMerge">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF53E;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Merge PDFs" FontSize="14"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="PdfSplit">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF423;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Split PDF" FontSize="14"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="PdfToPng">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF3AD;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="PDF → PNG" FontSize="14"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>

            </Grid>
        </Border>

        <!-- Scrollable content area with the same transparent surface as Home. -->
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Padding="32,24,32,32" HorizontalAlignment="Stretch">
            
            <!-- Word → PDF -->
            <StackPanel x:Name="WordToPdfPanel" Spacing="18" HorizontalAlignment="Stretch" Visibility="Visible">
                <TextBlock x:Name="WordToolTitle" Text="Word → PDF" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="WordToolDescription" Text="Convert Word documents to PDF format using WordCraft."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                
                <StackPanel Spacing="16">
                    <!-- Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="WordInputPath" PlaceholderText="Select DOCX file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseWordInput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Output -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="WordOutputPath" PlaceholderText="PDF will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseWordOutput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Convert Button & Status -->
                    <StackPanel Spacing="12">
                        <Button x:Name="ConvertWordButton" Content="Convert to PDF" 
                                Click="ConvertWord_Click" 
                                IsEnabled="False"
                                Height="40"
                                Padding="24,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="WordProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="WordStatus" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenWordOutputButton" Content="Open file" Click="OpenWordOutput_Click" IsEnabled="False"/>
                            <Button x:Name="ShowWordOutputButton" Content="Show in folder" Click="ShowWordOutput_Click" IsEnabled="False"/>
                            <Button x:Name="CopyWordOutputButton" Content="Copy path" Click="CopyWordOutput_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- PowerPoint → PDF -->
            <StackPanel x:Name="PptToPdfPanel" Spacing="18" HorizontalAlignment="Stretch" Visibility="Collapsed">
                <TextBlock x:Name="PptToolTitle" Text="PowerPoint → PDF" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="PptToolDescription" Text="Convert PowerPoint presentations to PDF format using DeckCraft."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                
                <StackPanel Spacing="16">
                    <!-- Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PptInputPath" PlaceholderText="Select PPTX file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePptInput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Output -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PptOutputPath" PlaceholderText="PDF will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePptOutput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Convert Button & Status -->
                    <StackPanel Spacing="12">
                        <Button x:Name="ConvertPptButton" Content="Convert to PDF" 
                                Click="ConvertPpt_Click" 
                                IsEnabled="False"
                                Height="40"
                                Padding="24,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="PptProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="PptStatus" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenPptOutputButton" Content="Open file" Click="OpenPptOutput_Click" IsEnabled="False"/>
                            <Button x:Name="ShowPptOutputButton" Content="Show in folder" Click="ShowPptOutput_Click" IsEnabled="False"/>
                            <Button x:Name="CopyPptOutputButton" Content="Copy path" Click="CopyPptOutput_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Excel → CSV -->
            <StackPanel x:Name="ExcelToCsvPanel" Spacing="18" HorizontalAlignment="Stretch" Visibility="Collapsed">
                <TextBlock x:Name="ExcelToolTitle" Text="Excel → CSV" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="ExcelToolDescription" Text="Convert Excel spreadsheets to CSV format using GridCraft."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                
                <StackPanel Spacing="16">
                    <!-- Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ExcelInputPath" PlaceholderText="Select XLSX file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseExcelInput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Output -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output File" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ExcelOutputPath" PlaceholderText="CSV will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseExcelOutput_Click" Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Convert Button & Status -->
                    <StackPanel Spacing="12">
                        <Button x:Name="ConvertExcelButton" Content="Convert to CSV" 
                                Click="ConvertExcel_Click" 
                                IsEnabled="False"
                                Height="40"
                                Padding="24,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="ExcelProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="ExcelStatus" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenExcelOutputButton" Content="Open file" Click="OpenExcelOutput_Click" IsEnabled="False"/>
                            <Button x:Name="ShowExcelOutputButton" Content="Show in folder" Click="ShowExcelOutput_Click" IsEnabled="False"/>
                            <Button x:Name="CopyExcelOutputButton" Content="Copy path" Click="CopyExcelOutput_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="PdfToolsPanel" Spacing="18" HorizontalAlignment="Stretch" Visibility="Collapsed">
                <TextBlock x:Name="PdfToolTitle" Text="PDF tools" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="PdfToolDescription"
                           Text="Organize and export PDF files using PdfCraft."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>

                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PdfInputLabel" Text="Input file" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PdfInputPath"
                                     PlaceholderText="Select PDF file..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePdfInput_Click"
                                    Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PdfMergeFilesPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="PDF files to merge (drag to reorder)"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <!-- Cards wrap in a row, each shows PDF preview thumbnail -->
                        <ItemsRepeater x:Name="PdfMergeFilesRepeater"
                                       ItemsSource="{x:Bind _pdfMergeItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinItemHeight="240"
                                                   MinColumnSpacing="12" MinRowSpacing="12"
                                                   ItemsStretch="Fill" Orientation="Horizontal"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:PdfMergeFileItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10"
                                            CanDrag="True" AllowDrop="True">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top row: order badge + remove button -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="10" Width="24" Height="24">
                                                    <TextBlock Text="{x:Bind OrderIndex}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Tag="{x:Bind FilePath}"
                                                        Click="RemovePdfMergeFile_Click"
                                                        Width="28" Height="28" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        CornerRadius="4">
                                                    <FontIcon Glyph="&#xE711;" FontSize="14"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Button>
                                            </Grid>

                                            <!-- PDF preview thumbnail (2:3 ratio) -->
                                            <Border Grid.Row="1"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Width="140" Height="180"
                                                    HorizontalAlignment="Center">
                                                <Grid>
                                                    <!-- Thumbnail image -->
                                                    <Image x:Name="PreviewImage"
                                                           Source="{x:Bind PreviewThumbnail, Mode=OneWay}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                    
                                                    <!-- Loading indicator when thumbnail is being generated -->
                                                    <ProgressRing IsActive="True" Width="32" Height="32"
                                                                  Visibility="{x:Bind PreviewThumbnail, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    
                                                    <!-- Fallback PDF icon if no thumbnail -->
                                                    <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                                              Glyph="&#xF3AD;" FontSize="48"
                                                              Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                                                              Visibility="{x:Bind PreviewThumbnail, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Filename at bottom -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{x:Bind FileName}"
                                                       FontSize="12" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Button Content="+ Add PDF files" Click="AddPdfMergeFile_Click"
                                HorizontalAlignment="Left" Padding="16,10"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>

                    <!-- Split mode: page range input OR visual grid -->
                    <StackPanel x:Name="PdfSplitOptionsPanel" Spacing="14" Visibility="Collapsed">

                        <!-- Mode selector tabs -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Split method" FontSize="13" FontWeight="SemiBold"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="3" Height="38"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="SplitByRangeButton"
                                                 Grid.Column="0"
                                                 Content="Page range"
                                                 IsChecked="True"
                                                 MinWidth="110" Height="32" Padding="12,0"
                                                 CornerRadius="6"
                                                 Checked="SplitMode_Checked"
                                                 Style="{StaticResource SegmentedButtonStyle}"/>
                                    <RadioButton x:Name="SplitByPickButton"
                                                 Grid.Column="1"
                                                 Content="Pick pages"
                                                 MinWidth="110" Height="32" Padding="12,0"
                                                 CornerRadius="6"
                                                 Checked="SplitMode_Checked"
                                                 Style="{StaticResource SegmentedButtonStyle}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Page range entry -->
                        <StackPanel x:Name="SplitPageRangePanel" Spacing="8">
                            <TextBlock Text="Page range" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Enter a range like 1-5 or individual pages like 1,3,7 or combine: 1-3,5,8-10"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="SplitPageRangeInput"
                                         PlaceholderText="e.g. 1-5 or 1,3,7 or 1-3,5,8-10"
                                         Height="36"
                                         TextChanged="SplitPageRangeInput_TextChanged"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="SplitRangePageCount"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <TextBlock x:Name="SplitRangeError"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Visual page picker -->
                        <StackPanel x:Name="SplitPagePickerPanel" Spacing="8" Visibility="Collapsed">
                            <GridView x:Name="PdfSplitPagesGrid"
                                      SelectionMode="Multiple"
                                      SelectionChanged="PdfSplitPagesGrid_SelectionChanged"
                                      IsItemClickEnabled="False"
                                      MaxHeight="460">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="230"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="148" Spacing="6" Margin="0,4">
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="4">
                                                <Image Source="{Binding Preview}" Stretch="Uniform" Height="180"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel x:Name="PdfSplitSelectionPanel" Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="Select all" Click="SelectAllPdfPages_Click"/>
                                <Button Content="Clear" Click="ClearPdfPages_Click"/>
                                <TextBlock x:Name="PdfSplitSelectionStatus" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PdfOutputLabel" Text="Output file"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PdfOutputPath"
                                     PlaceholderText="Output will be saved here..." IsReadOnly="True" Height="36"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePdfOutput_Click"
                                    Height="36" Padding="16,8"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <Button x:Name="ProcessPdfButton" Content="Process PDF"
                                Click="ProcessPdf_Click" IsEnabled="False" Height="40"
                                Padding="24,10" Style="{StaticResource AccentButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="PdfProgress" Width="20" Height="20"
                                          IsActive="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="PdfStatus" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenPdfOutputButton" Content="Open file"
                                    Click="OpenPdfOutput_Click" IsEnabled="False"/>
                            <Button x:Name="ShowPdfOutputButton" Content="Show in folder"
                                    Click="ShowPdfOutput_Click" IsEnabled="False"/>
                            <Button x:Name="CopyPdfOutputButton" Content="Copy path"
                                    Click="CopyPdfOutput_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
