<Page
    x:Class="QuickView.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:QuickView.Features.Home"
    xmlns:models="using:QuickView.Core.Models"
    xmlns:controls="using:QuickView.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>

        <!-- ── Segmented Button Style (for Recent / All toggle) ─── -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckedStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Padding="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern Document Card Component ────────────────────────────────
             Modular, reusable card component with hover effects -->
        <DataTemplate x:Key="GridCardTemplate" x:DataType="models:DocumentItem">
            <controls:DocumentCard Document="{x:Bind Mode=OneWay}"/>
        </DataTemplate>

        <!-- ── Folder chip ──────────────────────────────────────────── -->
        <DataTemplate x:Key="FolderChipTemplate" x:DataType="x:String">
            <Grid Margin="0,0,0,4" Padding="12,8" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE8B7;" FontSize="13"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Button Grid.Column="2"
                        Tag="{x:Bind}"
                        Click="RemoveFolder_Click"
                        Width="24" Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="8,0,0,0">
                    <FontIcon Glyph="&#xE711;" FontSize="10"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <!-- ── Root two-column layout ────────────────────────────────────────── -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             LEFT — document area  (transparent, pure Mica)
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Search bar -->
                <RowDefinition Height="Auto"/>  <!-- Unified toolbar -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ── SEARCH BAR ────────────────────────────────────────────── -->
            <AutoSuggestBox
                x:Name="HomeSearchBox"
                Grid.Row="0"
                Margin="20,14,20,0"
                PlaceholderText="Search files…"
                QueryIcon="Find"
                CornerRadius="8"
                Height="40"
                TextChanged="HomeSearch_TextChanged"
                QuerySubmitted="HomeSearch_QuerySubmitted"/>

            <!-- ── UNIFIED TOOLBAR ── Segmented + Count + Grid/List + Clear ─ -->
            <Grid Grid.Row="1" Padding="20,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Segmented control: Recent / All Documents -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2"
                        Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RecentModeButton"
                                     Grid.Column="0"
                                     Content="Recent"
                                     IsChecked="True"
                                     MinWidth="84"
                                     Height="32"
                                     Padding="14,0"
                                     CornerRadius="6"
                                     Checked="ViewModeToggle_Checked"
                                     Style="{StaticResource SegmentedButtonStyle}"/>
                        <RadioButton x:Name="AllModeButton"
                                     Grid.Column="1"
                                     Content="All Documents"
                                     MinWidth="116"
                                     Height="32"
                                     Padding="14,0"
                                     CornerRadius="6"
                                     Checked="ViewModeToggle_Checked"
                                     Style="{StaticResource SegmentedButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Count label + spinner -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentCountLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ProgressRing x:Name="ScanProgressRing"
                                  Width="16" Height="16"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Clear (Recent mode only) -->
                <Button x:Name="ClearButton"
                        Grid.Column="3"
                        Padding="12,8"
                        Click="ClearRecent_Click"
                        ToolTipService.ToolTip="Clear recent files">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── CONTENT ────────────────────────────────────────────────── -->
            <Grid Grid.Row="2">

                <!-- Empty state with brand identity -->
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12" Padding="40">
                    <!-- App icon with subtle shadow -->
                    <Grid>
                        <Image
                            Source="/Assets/AppIcon.png"
                            Width="64" Height="64"
                            HorizontalAlignment="Center"
                            Opacity="0.85"/>
                    </Grid>
                    <TextBlock
                        Text="QuickView every file, very fast"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.7"
                        Margin="0,2,0,0"/>
                    <TextBlock
                        Text="Add folders to start browsing and previewing your files instantly."
                        FontSize="13"
                        HorizontalAlignment="Center" TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" MaxWidth="360"
                        Opacity="0.6"
                        Margin="0,0,0,10"/>
                    <Button
                        x:Name="EmptyAddFolderButton"
                        HorizontalAlignment="Center"
                        Padding="14,8"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AddFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Folder" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="EmptyOpenFileButton"
                        HorizontalAlignment="Center"
                        Padding="14,8"
                        Click="OpenFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Open File" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- No-results state -->
                <StackPanel
                    x:Name="NoResultsState"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="10" Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xE721;" FontSize="44"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock
                        Text="No documents match this filter"
                        Style="{StaticResource BodyTextBlockStyle}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Grid view — ItemsRepeater + UniformGridLayout
                     MinItemWidth drives column count automatically.
                     ItemsStretch.Fill distributes leftover width across all items
                     so every row is perfectly flush — no gaps at the edges. -->
                <ScrollViewer
                    x:Name="DocumentsGridView"
                    VerticalScrollBarVisibility="Auto"
                    Padding="16,10,16,10"
                    Visibility="Collapsed">
                    <ItemsRepeater
                        x:Name="DocumentsRepeater"
                        ItemsSource="{x:Bind FilteredDocuments}"
                        ElementPrepared="DocumentsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="185"
                                MinItemHeight="165"
                                MinColumnSpacing="12"
                                MinRowSpacing="12"
                                ItemsStretch="Fill"
                                Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:DocumentItem">
                                <controls:DocumentCard Document="{x:Bind Mode=OneWay}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Grouped view — shows documents organized by folders/type/date -->
                <ScrollViewer
                    x:Name="GroupedDocumentsView"
                    VerticalScrollBarVisibility="Auto"
                    Padding="16,10,16,10"
                    Visibility="Collapsed">
                    <ItemsRepeater
                        x:Name="GroupedRepeater"
                        ItemsSource="{x:Bind ViewModel.GroupedDocuments, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="24"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:DocumentGroup">
                                <StackPanel Spacing="12">
                                    <!-- Group Header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind GroupName}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="10"
                                            Padding="8,3">
                                            <TextBlock
                                                Text="{x:Bind ItemCount}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Group Items -->
                                    <ItemsRepeater
                                        ItemsSource="{x:Bind Items}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinItemWidth="185"
                                                MinItemHeight="165"
                                                MinColumnSpacing="12"
                                                MinRowSpacing="12"
                                                ItemsStretch="Fill"
                                                Orientation="Horizontal"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:DocumentItem">
                                                <controls:DocumentCard Document="{x:Bind Mode=OneWay}"/>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
             RIGHT — floating filter panel
             No border, transparent background — blends with the Mica/Acrylic window backdrop.
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Padding="16,14,16,16" Spacing="24">

                    <!-- ── Folders ────────────────────────────────────────── -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="FOLDERS"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                CharacterSpacing="80"/>
                            <Button
                                x:Name="AddFolderButton"
                                Grid.Column="1"
                                Padding="10,6"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Click="AddFolder_Click"
                                ToolTipService.ToolTip="Add folder to scan">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="OpenFileButton"
                                Grid.Column="2"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Click="OpenFile_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Open a file directly">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView
                            x:Name="FolderList"
                            ItemsSource="{x:Bind ScannedFolders}"
                            SelectionMode="None"
                            ItemTemplate="{StaticResource FolderChipTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <Button
                            x:Name="RescanButton"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"
                            Click="Rescan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Rescan" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ── File Type ──────────────────────────────────────── -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="FILE TYPE"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            CharacterSpacing="60"/>
                        <ComboBox
                            x:Name="FileTypeFilter"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="FileTypeFilter_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="All Types" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="PDF">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF3AD;" FontSize="13" Foreground="#DC3545" VerticalAlignment="Center"/>
                                    <TextBlock Text="PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="DOCX">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF0C22;" FontSize="13" Foreground="#256EFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="Word" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="PPTX">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF12B;" FontSize="13" Foreground="#D14A00" VerticalAlignment="Center"/>
                                    <TextBlock Text="PowerPoint" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="XLSX">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xE54C;" FontSize="13" Foreground="#218838" VerticalAlignment="Center"/>
                                    <TextBlock Text="Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="TXT">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Text" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="IMAGE">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF489;" FontSize="13" Foreground="#14A0A0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Images" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="VIDEO">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="13" Foreground="#8232C8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Video" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="ARCHIVE">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="#A07800" VerticalAlignment="Center"/>
                                    <TextBlock Text="Archives" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="CODE">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#148CC8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Code" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- ── Sort ───────────────────────────────────────────── -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SORT BY"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            CharacterSpacing="60"/>
                        <ComboBox
                            x:Name="SortOptions"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="SortOptions_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8CB;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Name" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Date Modified" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F3;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="File Size" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="File Type" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- ── Group By ──────────────────────────────────────── -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="GROUP BY"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            CharacterSpacing="60"/>
                        <ComboBox
                            x:Name="GroupByOptions"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="GroupByOptions_SelectionChanged">
                            <ComboBoxItem Tag="None">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8FE;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="None" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Folder">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Folder" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="FileType">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="File Type" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Date">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Date" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Bottom nav row: Settings + Tools ──────────────────────── -->
            <Grid Grid.Row="1" Margin="16,6,16,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Padding="0,8"
                    Click="NavigateToSettings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Padding="0,8"
                    Click="NavigateToTools_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE90F;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Tools" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>

    </Grid>
</Page>
