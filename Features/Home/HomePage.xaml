<Page
    x:Class="QuickView.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:QuickView.Features.Home"
    xmlns:models="using:QuickView.Models"
    xmlns:controls="using:QuickView.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>

        <!-- ── Segmented Button Style (for Recent / All toggle) ─── -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckedStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Padding="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern Document Card Component ────────────────────────────────
             Modular, reusable card component with hover effects -->
        <DataTemplate x:Key="GridCardTemplate" x:DataType="models:DocumentItem">
            <controls:DocumentCard Document="{x:Bind Mode=OneWay}"/>
        </DataTemplate>

        <!-- ── Modern Document List Item Component ───────────────────────
             Modular, reusable list item component with hover effects -->
        <DataTemplate x:Key="ListRowTemplate" x:DataType="models:DocumentItem">
            <controls:DocumentListItem Document="{x:Bind Mode=OneWay}"/>
        </DataTemplate>

        <!-- ── Folder chip ──────────────────────────────────────────── -->
        <DataTemplate x:Key="FolderChipTemplate" x:DataType="x:String">
            <Grid Margin="0,0,0,4" Padding="12,8" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE8B7;" FontSize="13"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Button Grid.Column="2"
                        Tag="{x:Bind}"
                        Click="RemoveFolder_Click"
                        Width="24" Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="8,0,0,0">
                    <FontIcon Glyph="&#xE711;" FontSize="10"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <!-- ── Root two-column layout ────────────────────────────────────────── -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             LEFT — document area  (transparent, pure Mica)
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Search bar -->
                <RowDefinition Height="Auto"/>  <!-- Unified toolbar -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ── SEARCH BAR ────────────────────────────────────────────── -->
            <AutoSuggestBox
                x:Name="HomeSearchBox"
                Grid.Row="0"
                Margin="20,14,20,0"
                PlaceholderText="Search files…"
                QueryIcon="Find"
                CornerRadius="8"
                Height="40"
                TextChanged="HomeSearch_TextChanged"
                QuerySubmitted="HomeSearch_QuerySubmitted"/>

            <!-- ── UNIFIED TOOLBAR ── Segmented + Count + Grid/List + Clear ─ -->
            <Grid Grid.Row="1" Padding="20,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Segmented control: Recent / All Documents -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2"
                        Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RecentModeButton"
                                     Grid.Column="0"
                                     Content="Recent"
                                     IsChecked="True"
                                     MinWidth="84"
                                     Height="32"
                                     Padding="14,0"
                                     CornerRadius="6"
                                     Checked="ViewModeToggle_Checked"
                                     Style="{StaticResource SegmentedButtonStyle}"/>
                        <RadioButton x:Name="AllModeButton"
                                     Grid.Column="1"
                                     Content="All Documents"
                                     MinWidth="116"
                                     Height="32"
                                     Padding="14,0"
                                     CornerRadius="6"
                                     Checked="ViewModeToggle_Checked"
                                     Style="{StaticResource SegmentedButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Count label + spinner -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentCountLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ProgressRing x:Name="ScanProgressRing"
                                  Width="16" Height="16"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Grid / List toggle -->
                <Border Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2"
                        Height="36"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RadioButton x:Name="GridViewToggle"
                                     ToolTipService.ToolTip="Grid view"
                                     Width="32" Height="32" Padding="0"
                                     CornerRadius="6"
                                     IsChecked="True"
                                     Checked="ViewToggle_Checked"
                                     Style="{StaticResource SegmentedButtonStyle}">
                            <FontIcon Glyph="&#xECA5;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton x:Name="ListViewToggle"
                                     ToolTipService.ToolTip="List view"
                                     Width="32" Height="32" Padding="0"
                                     CornerRadius="6"
                                     Checked="ViewToggle_Checked"
                                     Style="{StaticResource SegmentedButtonStyle}">
                            <FontIcon Glyph="&#xE8FD;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Clear (Recent mode only) -->
                <Button x:Name="ClearButton"
                        Grid.Column="4"
                        Padding="12,8"
                        Click="ClearRecent_Click"
                        ToolTipService.ToolTip="Clear recent files">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── CONTENT ────────────────────────────────────────────────── -->
            <Grid Grid.Row="2">

                <!-- Empty state with brand identity -->
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16" Padding="40">
                    <!-- App icon with subtle shadow -->
                    <Grid>
                        <Image
                            Source="/Assets/AppIcon.png"
                            Width="80" Height="80"
                            HorizontalAlignment="Center"
                            Opacity="0.9"/>
                    </Grid>
                    <TextBlock
                        Text="QuickView"
                        FontSize="40" FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    <TextBlock
                        Text="QuickView every file, very fast"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock
                        Text="Add folders to start browsing and previewing your files instantly."
                        Style="{StaticResource BodyTextBlockStyle}"
                        HorizontalAlignment="Center" TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" MaxWidth="380"
                        Margin="0,4,0,8"/>
                    <Button
                        x:Name="EmptyAddFolderButton"
                        HorizontalAlignment="Center"
                        Padding="16,10"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AddFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Folder" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="EmptyOpenFileButton"
                        HorizontalAlignment="Center"
                        Padding="16,10"
                        Click="OpenFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Open File" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- No-results state -->
                <StackPanel
                    x:Name="NoResultsState"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="10" Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xE721;" FontSize="44"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock
                        Text="No documents match this filter"
                        Style="{StaticResource BodyTextBlockStyle}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Grid view — ItemsRepeater + UniformGridLayout
                     MinItemWidth drives column count automatically.
                     ItemsStretch.Fill distributes leftover width across all items
                     so every row is perfectly flush — no gaps at the edges. -->
                <ScrollViewer
                    x:Name="DocumentsGridView"
                    VerticalScrollBarVisibility="Auto"
                    Padding="16,10,16,10"
                    Visibility="Collapsed">
                    <ItemsRepeater
                        x:Name="DocumentsRepeater"
                        ItemsSource="{x:Bind FilteredDocuments}"
                        ElementPrepared="DocumentsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="185"
                                MinItemHeight="165"
                                MinColumnSpacing="12"
                                MinRowSpacing="12"
                                ItemsStretch="Fill"
                                Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:DocumentItem">
                                <controls:DocumentCard Document="{x:Bind Mode=OneWay}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- List view — rows on transparent bg -->
                <ListView
                    x:Name="DocumentsListView"
                    Padding="18,6"
                    ItemsSource="{x:Bind FilteredDocuments}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="Documents_ItemClick"
                    ItemTemplate="{StaticResource ListRowTemplate}"
                    Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
                            <Setter Property="Padding"                    Value="0,0,0,8"/>
                            <Setter Property="Margin"                     Value="0"/>
                            <Setter Property="Background"                 Value="Transparent"/>
                            <Setter Property="BorderThickness"            Value="0"/>
                            <Setter Property="MinHeight"                  Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
             RIGHT — floating filter panel
             Single hairline left border, transparent background — blends
             with the Mica/Acrylic window backdrop.
             ════════════════════════════════════════════════════════════════ -->
        <Border
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Padding="16,14,16,24" Spacing="18">

                    <!-- ── Folders ────────────────────────────────────────── -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="FOLDERS"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                CharacterSpacing="80"/>
                            <Button
                                x:Name="OpenFileButton"
                                Grid.Column="1"
                                Padding="10,6"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Click="OpenFile_Click"
                                ToolTipService.ToolTip="Open a file directly">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="AddFolderButton"
                                Grid.Column="2"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Click="AddFolder_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Add folder to scan">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView
                            x:Name="FolderList"
                            ItemsSource="{x:Bind ScannedFolders}"
                            SelectionMode="None"
                            ItemTemplate="{StaticResource FolderChipTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <Button
                            x:Name="RescanButton"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"
                            Click="Rescan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Rescan" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>

                    <!-- ── File Type ──────────────────────────────────────── -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="FILE TYPE"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            CharacterSpacing="60"/>
                        <ComboBox
                            x:Name="FileTypeFilter"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="FileTypeFilter_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="All Types" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="PDF">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA90;" FontSize="13" Foreground="#DC3545" VerticalAlignment="Center"/>
                                    <TextBlock Text="PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="DOCX">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#256EFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="Word" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="PPTX">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D1;" FontSize="13" Foreground="#D14A00" VerticalAlignment="Center"/>
                                    <TextBlock Text="PowerPoint" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="XLSX">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F9;" FontSize="13" Foreground="#218838" VerticalAlignment="Center"/>
                                    <TextBlock Text="Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="TXT">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Text" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="IMAGE">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#14A0A0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Images" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="VIDEO">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="13" Foreground="#8232C8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Video" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="ARCHIVE">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="#A07800" VerticalAlignment="Center"/>
                                    <TextBlock Text="Archives" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="CODE">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#148CC8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Code" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>

                    <!-- ── Sort ───────────────────────────────────────────── -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SORT BY"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            CharacterSpacing="60"/>
                        <ComboBox
                            x:Name="SortOptions"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="SortOptions_SelectionChanged">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8CB;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Name" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Date Modified" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F3;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="File Size" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Type" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <!-- A→Z / Z→A -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SortAscButton"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,8"
                                    Margin="0,0,4,0"
                                    Click="SortAsc_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74B;" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="A → Z" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SortDescButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,8"
                                    Margin="4,0,0,0"
                                    Click="SortDesc_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74A;" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Z → A" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>

                    <!-- ── Statistics ─────────────────────────────────────── -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="STATISTICS"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            CharacterSpacing="60"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Files"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalFilesLabel" Grid.Column="1" Text="0"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Size"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalSizeLabel" Grid.Column="1" Text="0 B"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>
