<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged WinUI 3 -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
    <AppxGeneratePrisForPortableLibraries>false</AppxGeneratePrisForPortableLibraries>
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>

    <!-- Self-contained Windows App SDK — bundles Windows App SDK runtime -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- This is a Windows-only app — suppress the CA1416 "Windows-only API"
         flood that the Windows App SDK injects on every WinUI call (~1600 hits). -->
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045</NoWarn>

    <!-- Suppress duplicate assembly attributes (CS0579) that occur when
         -r win-x64 and -p:Platform=x64 are both passed to dotnet publish. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- App icon — embeds into exe PE so Explorer shows it in Properties -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- Version / file info visible in Explorer → Properties → Details -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>QuickView Contributors</Company>
    <Product>QuickView</Product>
    <Description>Fast universal file viewer for Windows</Description>
    <Copyright>Copyright © 2025 QuickView Contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK"              Version="2.4.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D"             Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm"                Version="8.4.2" />
    <PackageReference Include="PdfSharpCore"                         Version="1.3.65" />
    <PackageReference Include="PDFiumCore"                           Version="97.0.4690" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" Exclude="Assets\SampleMedia\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Exclude tools/ subfolder so EmbedIcon.cs is never compiled into the app -->
    <Compile Remove="tools\**\*" />
    <None   Remove="tools\**\*" />
    <Content Remove="tools\**\*" />
  </ItemGroup>

  <!-- Skip MRT packaging targets for unpackaged apps -->
  <Target Name="_SkipMrtCoreTargets"
          BeforeTargets="_GeneratePriConfigXmlForResourcePack;_GeneratePriConfigXml;_GeneratePrisForPortableLibraries;_RemovePayloadDuplicates" />

</Project>
