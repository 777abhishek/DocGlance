<Application
    x:Class="DocGlance.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DocGlanceSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DocGlanceElevatedSurfaceBrush" Color="#FFF3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DocGlanceSurfaceBrush" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="DocGlanceElevatedSurfaceBrush" Color="#FF2C2C2C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
