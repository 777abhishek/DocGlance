<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- MSIX packaged app — Package.appxmanifest provides identity and file associations.
         WindowsPackageType defaults to MSIX when not set to None, so no explicit value needed.
         EnableMsixTooling wires up the manifest and packaging pipeline. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Sign the MSIX with our self-signed cert (Subject must match Identity Publisher).
         Signed by thumbprint from the current user's cert store: MSBuild cannot import
         CNG-keyed PFX files (APPX0105). Recreate/re-export with tools\sign-package.ps1. -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>959E3537149C890544FEC5E729DD9A0DC961C44A</PackageCertificateThumbprint>

    <!-- Define PACKAGED symbol so code can branch at compile time between
         packaged (Store) and unpackaged (direct EXE) behaviors. -->
    <DefineConstants>$(DefineConstants);PACKAGED</DefineConstants>

    <!-- Windows App SDK self-contained: bundles the WinAppSDK runtime so users
         don't need to install it separately. Keep this for a smoother Store install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Performance optimizations for Release builds -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>true</PublishReadyToRunShowWarnings>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>

    <!-- Assembly trimming — WinUI 3 doesn't fully support trimming yet -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Debug symbols for crash reports -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Suppress CA1416 (Windows-only API) and MVVMTK0045 floods from WinAppSDK -->
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045</NoWarn>

    <!-- Suppress duplicate assembly attribute warnings (CS0579) when both
         -r win-x64 and -p:Platform=x64 are passed to dotnet publish. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- Use our custom Program.cs main so we can set PerMonitorV2 DPI awareness
         before any WinUI / Windows App SDK code runs (fixes blurry 4K rendering) -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- App icon embedded in the PE (Explorer Properties → Details) -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- Version / file info -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>14.10.26.0</FileVersion>
    <InformationalVersion>14.10.26</InformationalVersion>
    <Company>777abhishek</Company>
    <Product>DocGlance</Product>
    <Description>Fast universal file viewer for Windows</Description>
    <Copyright>Copyright © 2026 777abhishek</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />

    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Workaround for MSIX build tools missing System.Security.Permissions in .NET 8 -->
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
  </ItemGroup>

  <!-- Exclude Properties\AssemblyInfo.cs is NOT needed: GenerateAssemblyInfo=false means
       only our manual file emits attributes, no CS0579 duplicates. -->

  <ItemGroup>
    <Content Include="Assets\**\*" Exclude="Assets\SampleMedia\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Exclude tools/ subfolder so EmbedIcon.cs is never compiled into the app -->
    <Compile Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Content Remove="tools\**\*" />
    <!-- Exclude test project subfolder from main project compilation -->
    <Compile Remove="DocGlance.Tests\**\*" />
    <None Remove="DocGlance.Tests\**\*" />
    <Content Remove="DocGlance.Tests\**\*" />
  </ItemGroup>

  <!-- Native Rust DLLs — copied from build-native.ps1 output for publish support -->
  <ItemGroup>
    <Content Include="native\deckcraft_ffi\target\release\deckcraft_ffi.dll" Condition="Exists('native\deckcraft_ffi\target\release\deckcraft_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>deckcraft_ffi.dll</Link>
    </Content>
    <Content Include="native\wordcraft_ffi\target\release\wordcraft_ffi.dll" Condition="Exists('native\wordcraft_ffi\target\release\wordcraft_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>wordcraft_ffi.dll</Link>
    </Content>
    <Content Include="native\gridcraft_ffi\target\release\gridcraft_ffi.dll" Condition="Exists('native\gridcraft_ffi\target\release\gridcraft_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>gridcraft_ffi.dll</Link>
    </Content>
    <Content Include="native\pdfcraft_ffi\target\release\pdfcraft_ffi.dll" Condition="Exists('native\pdfcraft_ffi\target\release\pdfcraft_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>pdfcraft_ffi.dll</Link>
    </Content>
  </ItemGroup>

</Project>
