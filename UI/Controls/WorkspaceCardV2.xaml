<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocGlance.UI.Controls.WorkspaceCardV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="WorkspaceContextButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#55000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Button x:Name="CardButton" Padding="0" BorderThickness="0"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            Background="Transparent" Click="CardButton_Click"
            ToolTipService.ToolTip="Open workspace">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Rectangle Fill="#01000000" IsHitTestVisible="True"/>

            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid Width="280" Height="200">
                    <Border CornerRadius="12" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>

                            <!-- 1. Wallet back: tinted by dominant file type -->
                            <Border CornerRadius="11,11,14,14">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="GradientStart" Offset="0" Color="#FF2E3648"/>
                                                <GradientStop x:Name="GradientEnd" Offset="1" Color="#FF4A5568"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.0" Color="#00000000"/>
                                                <GradientStop Offset="0.6" Color="#15000000"/>
                                                <GradientStop Offset="1.0" Color="#55000000"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- 2. Documents peeking out (built in code-behind) -->
                            <Canvas x:Name="CardsHost" Width="280" Height="130"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsHitTestVisible="False"/>

                            <!-- 3. Same curved info panel as DocumentCard -->
                            <Grid Height="100" VerticalAlignment="Bottom">
                                <Path Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,28" IsClosed="True">
                                                <LineSegment Point="0,88"/>
                                                <QuadraticBezierSegment Point1="0,100" Point2="12,100"/>
                                                <LineSegment Point="268,100"/>
                                                <QuadraticBezierSegment Point1="280,100" Point2="280,88"/>
                                                <LineSegment Point="280,35"/>
                                                <BezierSegment Point1="255,35" Point2="230,33" Point3="205,27"/>
                                                <BezierSegment Point1="180,21" Point2="150,14" Point3="120,12"/>
                                                <LineSegment Point="12,12"/>
                                                <QuadraticBezierSegment Point1="0,12" Point2="0,28"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                            </Grid>

                            <!-- 4. Startup pill -->
                            <Border x:Name="StartupPill" Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="12,12,0,0" Padding="8,4" CornerRadius="10" Background="#66000000">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="White"/>
                                    <TextBlock x:Name="StartupStatus" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Text content -->
                            <Grid Margin="16,0,16,10" VerticalAlignment="Bottom">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="WorkspaceName" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="DocumentPreview" Grid.Row="1" Margin="0,4,0,0" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DocumentCountLabel" Grid.Column="1" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Options menu -->
                    <Button x:Name="OptionsButton" Style="{StaticResource WorkspaceContextButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                            Canvas.ZIndex="10" ToolTipService.ToolTip="Workspace options">
                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Update from open tabs" Click="UpdateMenuItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="StartupMenuItem" Click="StartupMenuItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Delete workspace" Click="DeleteMenuItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Viewbox>
        </Grid>
    </Button>
</UserControl>
