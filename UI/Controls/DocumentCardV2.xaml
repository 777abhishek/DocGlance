<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocGlance.UI.Controls.DocumentCardV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ContextButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
        </Style>
    </UserControl.Resources>

    <Button x:Name="CardButton" Padding="0" BorderThickness="0"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            Background="Transparent" Click="CardButton_Click"
            ToolTipService.ToolTip="Open document">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Rectangle Fill="#01000000" IsHitTestVisible="True"/>

            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid Width="280" Height="200">
                    <Border CornerRadius="12" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>

                            <!-- 1. Type-coloured gradient -->
                            <Border CornerRadius="11,11,14,14">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="GradientStart" Offset="0" Color="#FFDC3545"/>
                                                <GradientStop x:Name="GradientEnd" Offset="1" Color="#FFF0505F"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Image x:Name="ThumbnailImage" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Visibility="Collapsed"/>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.0" Color="#00000000"/>
                                                <GradientStop Offset="0.6" Color="#15000000"/>
                                                <GradientStop Offset="1.0" Color="#55000000"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- 2. Big faint extension watermark (shows type even without a thumbnail) -->
                            <TextBlock x:Name="WatermarkText"
                                       FontSize="72" FontWeight="Black"
                                       Foreground="White" Opacity="0.3"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,14,0,0"
                                       IsHitTestVisible="False"/>

                            <!-- 3. Curved info panel (unchanged shape) -->
                            <Grid Height="100" VerticalAlignment="Bottom">
                                <Path Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,28" IsClosed="True">
                                                <LineSegment Point="0,88"/>
                                                <QuadraticBezierSegment Point1="0,100" Point2="12,100"/>
                                                <LineSegment Point="268,100"/>
                                                <QuadraticBezierSegment Point1="280,100" Point2="280,88"/>
                                                <LineSegment Point="280,35"/>
                                                <BezierSegment Point1="255,35" Point2="230,33" Point3="205,27"/>
                                                <BezierSegment Point1="180,21" Point2="150,14" Point3="120,12"/>
                                                <LineSegment Point="12,12"/>
                                                <QuadraticBezierSegment Point1="0,12" Point2="0,28"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                            </Grid>

                            <!-- 5. Text content -->
                            <Grid Margin="16,0,16,10" VerticalAlignment="Bottom">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FileNameText" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FileTypeDesc" Grid.Column="0" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Name="ModifiedText" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="FileSizeText" Grid.Row="3" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Context menu: inside the scaled card so it always hugs the top-right corner -->
                    <Button x:Name="ContextMenuButton" Style="{StaticResource ContextButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                            Canvas.ZIndex="10" ToolTipService.ToolTip="More options">
                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="White"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Open" Click="OpenMenuItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem x:Name="BookmarkToggle" Text="Bookmark" Click="BookmarkMenuItem_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;"/></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutItem Text="Show in File Explorer" Click="ShowInExplorerMenuItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Share" Click="ShareMenuItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem Text="Open with">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7AC;"/></MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Text="Default app" Click="OpenWithDefaultMenuItem_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Choose another app..." Click="OpenWithChooseMenuItem_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE712;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Viewbox>
        </Grid>
    </Button>
</UserControl>
