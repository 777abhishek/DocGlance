<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocGlance.UI.Controls.WorkspaceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="WorkspaceContextButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
    </UserControl.Resources>

    <!-- Same structure as DocumentCard: one big button = reliable hit-testing, menu button floats on top -->
    <Button
        x:Name="CardButton"
        Padding="0"
        BorderThickness="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Background="Transparent"
        Click="CardButton_Click"
        ToolTipService.ToolTip="Open workspace">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid Background="{TemplateBinding Background}">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
                </Grid>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Rectangle Fill="#01000000" IsHitTestVisible="True"/>

            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <!-- Identical size to DocumentCard so both grids line up -->
                <Grid Width="280" Height="200">

                    <Border CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>

                            <!-- 1. Back of the wallet: tinted by the dominant file format -->
                            <Border CornerRadius="11">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="GradientStart" Offset="0" Color="#FF2E3648"/>
                                                <GradientStop x:Name="GradientEnd" Offset="1" Color="#FF4A5568"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.0" Color="#22FFFFFF"/>
                                                <GradientStop Offset="1.0" Color="#33000000"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- 2. Cards sitting inside the wallet (built in code-behind) -->
                            <Canvas x:Name="CardsHost"
                                    Width="280" Height="120"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"/>

                            <!-- 3. Translucent front pocket -->
                            <Border Height="108"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="14,14,11,11"
                                    BorderThickness="1,1,1,0"
                                    BorderBrush="#55FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="#55FFFFFF"/>
                                        <GradientStop Offset="0.35" Color="#26FFFFFF"/>
                                        <GradientStop Offset="1.0" Color="#66000000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Pocket text -->
                            <Grid Margin="16,0,16,12" VerticalAlignment="Bottom">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="WorkspaceName" Grid.Row="0"
                                           FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="White"/>

                                <TextBlock x:Name="DocumentPreview" Grid.Row="1"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="#CCFFFFFF"/>

                                <Grid Grid.Row="2" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="ChipsPanel"
                                                Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DocumentCountLabel" Grid.Column="1"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Grid>
                            </Grid>

                            <!-- Startup pill -->
                            <Border x:Name="StartupPill"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="10,10,0,0" Padding="8,3"
                                    CornerRadius="10"
                                    Background="#66000000">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons"
                                              FontSize="10" Foreground="White"/>
                                    <TextBlock x:Name="StartupStatus" FontSize="10"
                                               FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

            <!-- Three-dot menu: lives INSIDE the scaled 280x200 card so it always sits on the card's top-right corner -->
            <Button
                x:Name="OptionsButton"
                Style="{StaticResource WorkspaceContextButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Canvas.ZIndex="10"
                ToolTipService.ToolTip="Workspace options">
                <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14"
                          Foreground="White"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem x:Name="UpdateMenuItem"
                                        Text="Update from open tabs"
                                        Click="UpdateMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="StartupMenuItem"
                                        Click="StartupMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="DeleteMenuItem"
                                        Text="Delete workspace"
                                        Click="DeleteMenuItem_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

                </Grid>
            </Viewbox>
        </Grid>
    </Button>

</UserControl>
