<UserControl
    x:Class="QuickView.UI.Controls.PageThumbnailSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickView.Core.Models"
    Width="220">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.Resources>
            <!-- Custom button style without hover background -->
            <Style x:Key="ThumbnailButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid 
            Grid.Row="0" 
            Height="48" 
            Padding="16,0">
            <TextBlock 
                Text="Pages" 
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <!-- Thumbnail List -->
        <ScrollViewer 
            Grid.Row="1"
            Padding="8">
            <ItemsRepeater 
                x:Name="ThumbnailList"
                ItemsSource="{x:Bind PageItems}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:PageThumbnailItem">
                        <Button
                            Style="{StaticResource ThumbnailButtonStyle}"
                            Click="ThumbnailButton_Click"
                            Tag="{x:Bind PageNumber}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Thumbnail Image Container -->
                                <Border
                                    Grid.Row="0"
                                    Width="180"
                                    Height="230"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    
                                    <Grid>
                                        <!-- Gradient Background (when no thumbnail) -->
                                        <Border x:Name="PreviewBackground">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#B31818" Offset="0" />
                                                    <GradientStop Color="#E23350" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                                Glyph="&#xF3AD;" 
                                                FontSize="48"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Opacity="0.3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Actual Thumbnail (if available) -->
                                        <Image 
                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind HasThumbnail, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Page Number Label -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind PageLabel}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
