<UserControl
    x:Class="QuickView.UI.Controls.PageThumbnailSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickView.Core.Models"
    Width="220">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid 
            Grid.Row="0" 
            Height="48" 
            Padding="16,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <TextBlock 
                Text="Pages" 
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <!-- Thumbnail List -->
        <ScrollViewer 
            Grid.Row="1"
            Padding="8">
            <ItemsRepeater 
                x:Name="ThumbnailList"
                ItemsSource="{x:Bind PageItems}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:PageThumbnailItem">
                        <Button
                            Padding="8"
                            HorizontalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Click="ThumbnailButton_Click"
                            Tag="{x:Bind PageNumber}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Thumbnail Image Container -->
                                <Border
                                    Grid.Row="0"
                                    Width="180"
                                    Height="230"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    
                                    <Grid>
                                        <!-- Gradient Background (when no thumbnail) -->
                                        <Border x:Name="PreviewBackground">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#B31818" Offset="0" />
                                                    <GradientStop Color="#E23350" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <FontIcon 
                                                Glyph="&#xEA90;" 
                                                FontSize="48"
                                                Foreground="White"
                                                Opacity="0.3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Actual Thumbnail (if available) -->
                                        <Image 
                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind HasThumbnail, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!-- Page Number Label -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind PageLabel}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
