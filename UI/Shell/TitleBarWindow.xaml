<?xml version="1.0" encoding="utf-8"?>
<!--
    TitleBarWindow.xaml
    Chrome-style TabView: Home tab (fixed, no close) + document tabs (closeable).
    Pattern from Rune/MainWindow.xaml — TabView IS the title bar.
-->
<Window
    x:Class="DocGlance.UI.Shell.TitleBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:update="using:DocGlance.UI.Controls"
    Title="DocGlance">


    <Grid x:Name="RootGrid" AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop"
          Background="{ThemeResource AppFrameBackground}">

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!--  DARK: Pure black tab bar, black inactive tabs, #202020 active tab  -->
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="TabViewBackground" Color="#000000"/>
                        <SolidColorBrush x:Key="TabViewTopBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#101010"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#181818"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#202020"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemSeparatorPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemSeparatorSelected" Color="Transparent"/>
                    </ResourceDictionary>
                    
                    <!--  LIGHT: Pure white tab bar, white inactive tabs, #F2F2F2 active tab  -->
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="TabViewBackground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TabViewTopBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#F7F7F7"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#F0F0F0"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#F2F2F2"/>
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemSeparatorPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TabViewItemSeparatorSelected" Color="Transparent"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- TabView strip (= title bar) -->
            <RowDefinition Height="Auto"/>  <!-- Update notification banner -->
            <RowDefinition Height="*"/>     <!-- Page content -->
        </Grid.RowDefinitions>

        <!-- Update notification banner (hidden until an update is found) -->
        <update:UpdateBanner x:Name="UpdateBannerControl" Grid.Row="1" />

        <!-- ═══════════════════════════════════════════════════════
             TAB STRIP  — the Chrome/Rune pattern:
             the tab strip IS the title bar, drag area in footer.
             Home tab is fixed (no close), documents get close buttons.
             ═══════════════════════════════════════════════════════ -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            Canvas.ZIndex="100"
            TabWidthMode="Equal"
            CloseButtonOverlayMode="Always"
            CanTearOutTabs="False"
            CanReorderTabs="True"
            SelectionChanged="Tabs_SelectionChanged"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            Background="{ThemeResource AppFrameBackground}">

            <!-- Left of tabs: app icon and name in title bar style -->
            <TabView.TabStripHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="DocGlance"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </TabView.TabStripHeader>

            <!-- Right of tabs: window drag region -->
            <TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragArea"
                      Background="Transparent"
                      MinWidth="188"/>
            </TabView.TabStripFooter>

        </TabView>

        <!-- ═══════════════════════════════════════════════════════
             CONTENT AREA — each tab's page is shown here.
             Home page always present; viewer pages added per tab.
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Background="{ThemeResource AppContentBackground}">

            <!-- Home page — always loaded, shown/hidden per tab selection -->
            <Frame x:Name="HomeFrame"
                   Visibility="Visible">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
                <Frame.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Frame.OpacityTransition>
            </Frame>

            <!-- Document host — ViewerPage content is swapped in here -->
            <ContentControl
                x:Name="DocHost"
                Visibility="Collapsed"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
                <ContentControl.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </ContentControl.OpacityTransition>
            </ContentControl>

        </Grid>


    </Grid>
</Window>
