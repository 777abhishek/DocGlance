<!--  DocGlance Theme System
      Semantic brushes bind to palette colors
      NOTE: Palette must be merged at app level BEFORE this file  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///UI/Styles/FileTypes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--  Typography Styles  -->
    <Style x:Key="App.Theme.BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Theme.BodyTextBlockStyle" BasedOn="{StaticResource App.Theme.BaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="App.Theme.CaptionTextBlockStyle" BasedOn="{StaticResource App.Theme.BaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--  Semantic Brushes — bind to palette colors  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!--  App-level semantic brushes  -->
            <SolidColorBrush x:Key="AppFrameBackground" Color="{ThemeResource ColorFrameBackground}"/>
            <SolidColorBrush x:Key="AppContentBackground" Color="{ThemeResource ColorContentBackground}"/>
            <SolidColorBrush x:Key="AppSurface" Color="{ThemeResource ColorSurface}"/>
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="{ThemeResource ColorSurfaceElevated}"/>
            <SolidColorBrush x:Key="AppStroke" Color="{ThemeResource ColorStroke}"/>
            <SolidColorBrush x:Key="AppStrokeWeak" Color="{ThemeResource ColorStrokeWeak}"/>
            <SolidColorBrush x:Key="AppTextPrimary" Color="{ThemeResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="AppTextSecondary" Color="{ThemeResource ColorTextSecondary}"/>
            <SolidColorBrush x:Key="AppTextTertiary" Color="{ThemeResource ColorTextTertiary}"/>
            <SolidColorBrush x:Key="AppTextDisabled" Color="{ThemeResource ColorTextDisabled}"/>
            <SolidColorBrush x:Key="AppHover" Color="{ThemeResource ColorHover}"/>
            <SolidColorBrush x:Key="AppPressed" Color="{ThemeResource ColorPressed}"/>
            <SolidColorBrush x:Key="AppSelected" Color="{ThemeResource ColorSelected}"/>
            <SolidColorBrush x:Key="AppAccent" Color="{ThemeResource ColorAccent}"/>
            <SolidColorBrush x:Key="AppAccentHover" Color="{ThemeResource ColorAccentHover}"/>
            <SolidColorBrush x:Key="AppAccentPressed" Color="{ThemeResource ColorAccentPressed}"/>
            <SolidColorBrush x:Key="AppOnAccent" Color="{ThemeResource ColorOnAccent}"/>
            <SolidColorBrush x:Key="AppSuccess" Color="{ThemeResource ColorSuccess}"/>
            <SolidColorBrush x:Key="AppWarning" Color="{ThemeResource ColorWarning}"/>
            <SolidColorBrush x:Key="AppError" Color="{ThemeResource ColorError}"/>
            <SolidColorBrush x:Key="AppInfo" Color="{ThemeResource ColorInfo}"/>
            
            <!--  WinUI system brush overrides  -->
            <StaticResource x:Key="CardBackgroundFillColorDefaultBrush" ResourceKey="AppSurface"/>
            <StaticResource x:Key="CardStrokeColorDefaultBrush" ResourceKey="AppStroke"/>
            <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="AppTextSecondary"/>
            <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="AppTextTertiary"/>
            <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="AppTextDisabled"/>
            <StaticResource x:Key="ControlFillColorDefaultBrush" ResourceKey="AppSurface"/>
            <StaticResource x:Key="SurfaceStrokeColorDefaultBrush" ResourceKey="AppStroke"/>
            <StaticResource x:Key="SubtleFillColorSecondaryBrush" ResourceKey="AppHover"/>
            <StaticResource x:Key="SubtleFillColorTertiaryBrush" ResourceKey="AppSurface"/>
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AppAccent"/>
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="AppAccentHover"/>
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="AppAccentPressed"/>
            <StaticResource x:Key="AccentTextFillColorPrimaryBrush" ResourceKey="AppAccent"/>
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="AppOnAccent"/>
            <StaticResource x:Key="SystemFillColorSuccessBrush" ResourceKey="AppSuccess"/>
            <StaticResource x:Key="SystemFillColorCriticalBrush" ResourceKey="AppError"/>
            
            <!--  TabView specific overrides  -->
            <StaticResource x:Key="TabViewBackground" ResourceKey="AppFrameBackground"/>
            <SolidColorBrush x:Key="TabViewTopBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource ColorHover}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{ThemeResource ColorPressed}"/>
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="AppContentBackground"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
            <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="AppTextSecondary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundPressed" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundDisabled" ResourceKey="AppTextDisabled"/>
            <SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemSeparatorPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemSeparatorSelected" Color="Transparent"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!--  App-level semantic brushes  -->
            <SolidColorBrush x:Key="AppFrameBackground" Color="{ThemeResource ColorFrameBackground}"/>
            <SolidColorBrush x:Key="AppContentBackground" Color="{ThemeResource ColorContentBackground}"/>
            <SolidColorBrush x:Key="AppSurface" Color="{ThemeResource ColorSurface}"/>
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="{ThemeResource ColorSurfaceElevated}"/>
            <SolidColorBrush x:Key="AppStroke" Color="{ThemeResource ColorStroke}"/>
            <SolidColorBrush x:Key="AppStrokeWeak" Color="{ThemeResource ColorStrokeWeak}"/>
            <SolidColorBrush x:Key="AppTextPrimary" Color="{ThemeResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="AppTextSecondary" Color="{ThemeResource ColorTextSecondary}"/>
            <SolidColorBrush x:Key="AppTextTertiary" Color="{ThemeResource ColorTextTertiary}"/>
            <SolidColorBrush x:Key="AppTextDisabled" Color="{ThemeResource ColorTextDisabled}"/>
            <SolidColorBrush x:Key="AppHover" Color="{ThemeResource ColorHover}"/>
            <SolidColorBrush x:Key="AppPressed" Color="{ThemeResource ColorPressed}"/>
            <SolidColorBrush x:Key="AppSelected" Color="{ThemeResource ColorSelected}"/>
            <SolidColorBrush x:Key="AppAccent" Color="{ThemeResource ColorAccent}"/>
            <SolidColorBrush x:Key="AppAccentHover" Color="{ThemeResource ColorAccentHover}"/>
            <SolidColorBrush x:Key="AppAccentPressed" Color="{ThemeResource ColorAccentPressed}"/>
            <SolidColorBrush x:Key="AppOnAccent" Color="{ThemeResource ColorOnAccent}"/>
            <SolidColorBrush x:Key="AppSuccess" Color="{ThemeResource ColorSuccess}"/>
            <SolidColorBrush x:Key="AppWarning" Color="{ThemeResource ColorWarning}"/>
            <SolidColorBrush x:Key="AppError" Color="{ThemeResource ColorError}"/>
            <SolidColorBrush x:Key="AppInfo" Color="{ThemeResource ColorInfo}"/>
            
            <!--  WinUI system brush overrides  -->
            <StaticResource x:Key="CardBackgroundFillColorDefaultBrush" ResourceKey="AppSurface"/>
            <StaticResource x:Key="CardStrokeColorDefaultBrush" ResourceKey="AppStroke"/>
            <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="AppTextSecondary"/>
            <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="AppTextTertiary"/>
            <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="AppTextDisabled"/>
            <StaticResource x:Key="ControlFillColorDefaultBrush" ResourceKey="AppSurface"/>
            <StaticResource x:Key="SurfaceStrokeColorDefaultBrush" ResourceKey="AppStroke"/>
            <StaticResource x:Key="SubtleFillColorSecondaryBrush" ResourceKey="AppHover"/>
            <StaticResource x:Key="SubtleFillColorTertiaryBrush" ResourceKey="AppSurface"/>
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AppAccent"/>
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="AppAccentHover"/>
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="AppAccentPressed"/>
            <StaticResource x:Key="AccentTextFillColorPrimaryBrush" ResourceKey="AppAccent"/>
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="AppOnAccent"/>
            <StaticResource x:Key="SystemFillColorSuccessBrush" ResourceKey="AppSuccess"/>
            <StaticResource x:Key="SystemFillColorCriticalBrush" ResourceKey="AppError"/>
            
            <!--  TabView specific overrides  -->
            <StaticResource x:Key="TabViewBackground" ResourceKey="AppFrameBackground"/>
            <SolidColorBrush x:Key="TabViewTopBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource ColorHover}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{ThemeResource ColorPressed}"/>
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="AppContentBackground"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
            <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="AppTextSecondary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundPressed" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="AppTextPrimary"/>
            <StaticResource x:Key="TabViewItemHeaderForegroundDisabled" ResourceKey="AppTextDisabled"/>
            <SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemSeparatorPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemSeparatorSelected" Color="Transparent"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!--  High Contrast: use system colors  -->
            <SolidColorBrush x:Key="AppFrameBackground" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="AppContentBackground" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="AppSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="AppTextPrimary" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="AppTextSecondary" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="AppAccent" Color="{ThemeResource SystemColorHotlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
