<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  File Type Colors - Single Source of Truth
          Used by DocumentCard, WorkspaceCard, and Home filters  -->

    <!-- PDF -->
    <Color x:Key="FileType.PDF.Start">#E23350</Color>
    <Color x:Key="FileType.PDF.End">#C41E3A</Color>

    <!-- Microsoft Office -->
    <Color x:Key="FileType.Word.Start">#2B579A</Color>
    <Color x:Key="FileType.Word.End">#1E4A7A</Color>
    
    <Color x:Key="FileType.Excel.Start">#1D6F42</Color>
    <Color x:Key="FileType.Excel.End">#155C34</Color>
    
    <Color x:Key="FileType.PowerPoint.Start">#D04423</Color>
    <Color x:Key="FileType.PowerPoint.End">#B83B1E</Color>

    <!-- Code & Data -->
    <Color x:Key="FileType.Code.Start">#7C3AED</Color>
    <Color x:Key="FileType.Code.End">#6D28D9</Color>
    
    <Color x:Key="FileType.JSON.Start">#F59E0B</Color>
    <Color x:Key="FileType.JSON.End">#D97706</Color>
    
    <Color x:Key="FileType.XML.Start">#F97316</Color>
    <Color x:Key="FileType.XML.End">#EA580C</Color>
    
    <Color x:Key="FileType.CSV.Start">#10B981</Color>
    <Color x:Key="FileType.CSV.End">#059669</Color>

    <!-- Text & Documents -->
    <Color x:Key="FileType.Text.Start">#6B7280</Color>
    <Color x:Key="FileType.Text.End">#4B5563</Color>
    
    <Color x:Key="FileType.Markdown.Start">#3B82F6</Color>
    <Color x:Key="FileType.Markdown.End">#2563EB</Color>
    
    <Color x:Key="FileType.RichText.Start">#8B5CF6</Color>
    <Color x:Key="FileType.RichText.End">#7C3AED</Color>
    
    <Color x:Key="FileType.Log.Start">#78716C</Color>
    <Color x:Key="FileType.Log.End">#57534E</Color>

    <!-- Images -->
    <Color x:Key="FileType.Image.Start">#EC4899</Color>
    <Color x:Key="FileType.Image.End">#DB2777</Color>

    <!-- Default/Unknown -->
    <Color x:Key="FileType.Unknown.Start">#64748B</Color>
    <Color x:Key="FileType.Unknown.End">#475569</Color>

</ResourceDictionary>
