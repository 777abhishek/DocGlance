<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Gruvbox Palette - Retro warm theme  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#1D2021</Color>
            <Color x:Key="ColorContentBackground">#282828</Color>
            <Color x:Key="ColorSurface">#3C3836</Color>
            <Color x:Key="ColorSurfaceElevated">#504945</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#665C54</Color>
            <Color x:Key="ColorStrokeWeak">#4A4540</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#EBDBB2</Color>
            <Color x:Key="ColorTextSecondary">#D5C4A1</Color>
            <Color x:Key="ColorTextTertiary">#BDAE93</Color>
            <Color x:Key="ColorTextDisabled">#A89984</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#32302F</Color>
            <Color x:Key="ColorPressed">#3E3C3A</Color>
            <Color x:Key="ColorSelected">#282828</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#FABD2F</Color>
            <Color x:Key="ColorAccentHover">#FBC850</Color>
            <Color x:Key="ColorAccentPressed">#D9A01E</Color>
            <Color x:Key="ColorOnAccent">#1D2021</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#B8BB26</Color>
            <Color x:Key="ColorWarning">#FE8019</Color>
            <Color x:Key="ColorError">#FB4934</Color>
            <Color x:Key="ColorInfo">#83A598</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#EBDBB2</Color>
            <Color x:Key="ColorContentBackground">#FBF1C7</Color>
            <Color x:Key="ColorSurface">#FFFBE6</Color>
            <Color x:Key="ColorSurfaceElevated">#F5EDD0</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#D5C4A1</Color>
            <Color x:Key="ColorStrokeWeak">#E5D8BA</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#3C3836</Color>
            <Color x:Key="ColorTextSecondary">#504945</Color>
            <Color x:Key="ColorTextTertiary">#665C54</Color>
            <Color x:Key="ColorTextDisabled">#928374</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#F5EDD0</Color>
            <Color x:Key="ColorPressed">#E8DBBB</Color>
            <Color x:Key="ColorSelected">#FBF1C7</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#9D5A0B</Color>
            <Color x:Key="ColorAccentHover">#B5680C</Color>
            <Color x:Key="ColorAccentPressed">#854C09</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#79740E</Color>
            <Color x:Key="ColorWarning">#AF3A03</Color>
            <Color x:Key="ColorError">#9D0006</Color>
            <Color x:Key="ColorInfo">#076678</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
