<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Nord Palette - Arctic/Nordic inspired theme  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#242933</Color>
            <Color x:Key="ColorContentBackground">#2E3440</Color>
            <Color x:Key="ColorSurface">#3B4252</Color>
            <Color x:Key="ColorSurfaceElevated">#434C5E</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#4C566A</Color>
            <Color x:Key="ColorStrokeWeak">#3F4859</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#ECEFF4</Color>
            <Color x:Key="ColorTextSecondary">#D8DEE9</Color>
            <Color x:Key="ColorTextTertiary">#B8C3D3</Color>
            <Color x:Key="ColorTextDisabled">#8896A8</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#333B48</Color>
            <Color x:Key="ColorPressed">#3E4854</Color>
            <Color x:Key="ColorSelected">#2E3440</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#88C0D0</Color>
            <Color x:Key="ColorAccentHover">#9ECBD9</Color>
            <Color x:Key="ColorAccentPressed">#6FB0C0</Color>
            <Color x:Key="ColorOnAccent">#242933</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#A3BE8C</Color>
            <Color x:Key="ColorWarning">#EBCB8B</Color>
            <Color x:Key="ColorError">#BF616A</Color>
            <Color x:Key="ColorInfo">#81A1C1</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#E5E9F0</Color>
            <Color x:Key="ColorContentBackground">#ECEFF4</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceElevated">#F7F9FC</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#C8D0DE</Color>
            <Color x:Key="ColorStrokeWeak">#DCE2EB</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#2E3440</Color>
            <Color x:Key="ColorTextSecondary">#4C566A</Color>
            <Color x:Key="ColorTextTertiary">#687895</Color>
            <Color x:Key="ColorTextDisabled">#8896A8</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#F7F9FC</Color>
            <Color x:Key="ColorPressed">#DEE4ED</Color>
            <Color x:Key="ColorSelected">#ECEFF4</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#46698F</Color>
            <Color x:Key="ColorAccentHover">#567DA3</Color>
            <Color x:Key="ColorAccentPressed">#36557B</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#759F69</Color>
            <Color x:Key="ColorWarning">#C9A765</Color>
            <Color x:Key="ColorError">#9D4B54</Color>
            <Color x:Key="ColorInfo">#5E82A0</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
