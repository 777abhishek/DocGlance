<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Violet Palette - Purple/lavender theme  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#0F0A1A</Color>
            <Color x:Key="ColorContentBackground">#1A1230</Color>
            <Color x:Key="ColorSurface">#241A40</Color>
            <Color x:Key="ColorSurfaceElevated">#2E2250</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#3A2C5C</Color>
            <Color x:Key="ColorStrokeWeak">#2A1F48</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#EDE7FF</Color>
            <Color x:Key="ColorTextSecondary">#C7B8F0</Color>
            <Color x:Key="ColorTextTertiary">#A089D4</Color>
            <Color x:Key="ColorTextDisabled">#7A5AB8</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#1F1638</Color>
            <Color x:Key="ColorPressed">#2B1F4C</Color>
            <Color x:Key="ColorSelected">#1A1230</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#A78BFA</Color>
            <Color x:Key="ColorAccentHover">#BDA4FB</Color>
            <Color x:Key="ColorAccentPressed">#9172E8</Color>
            <Color x:Key="ColorOnAccent">#0F0A1A</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#4ADE80</Color>
            <Color x:Key="ColorWarning">#FBBF24</Color>
            <Color x:Key="ColorError">#F87171</Color>
            <Color x:Key="ColorInfo">#60A5FA</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#F1ECFB</Color>
            <Color x:Key="ColorContentBackground">#FBF9FF</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceElevated">#F5F0FC</Color>
            
            <!-- Strokes and divider -->
            <Color x:Key="ColorStroke">#D8CCF0</Color>
            <Color x:Key="ColorStrokeWeak">#EBE3F7</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#2A1B52</Color>
            <Color x:Key="ColorTextSecondary">#4A3775</Color>
            <Color x:Key="ColorTextTertiary">#6A5397</Color>
            <Color x:Key="ColorTextDisabled">#9580BA</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#F5F0FC</Color>
            <Color x:Key="ColorPressed">#E8DDF8</Color>
            <Color x:Key="ColorSelected">#FBF9FF</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#6D4AE0</Color>
            <Color x:Key="ColorAccentHover">#8263E8</Color>
            <Color x:Key="ColorAccentPressed">#5838C7</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#16A34A</Color>
            <Color x:Key="ColorWarning">#D97706</Color>
            <Color x:Key="ColorError">#DC2626</Color>
            <Color x:Key="ColorInfo">#2563EB</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
