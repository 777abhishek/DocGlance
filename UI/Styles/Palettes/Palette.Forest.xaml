<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Forest Palette - Green nature-inspired theme  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#0B120E</Color>
            <Color x:Key="ColorContentBackground">#14201A</Color>
            <Color x:Key="ColorSurface">#1C2C24</Color>
            <Color x:Key="ColorSurfaceElevated">#243A2E</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#2C4838</Color>
            <Color x:Key="ColorStrokeWeak">#1F3729</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#E6F2EA</Color>
            <Color x:Key="ColorTextSecondary">#B8D4C3</Color>
            <Color x:Key="ColorTextTertiary">#8AB69B</Color>
            <Color x:Key="ColorTextDisabled">#5C9873</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#213428</Color>
            <Color x:Key="ColorPressed">#2A4234</Color>
            <Color x:Key="ColorSelected">#14201A</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#3DDC84</Color>
            <Color x:Key="ColorAccentHover">#56E496</Color>
            <Color x:Key="ColorAccentPressed">#24C76F</Color>
            <Color x:Key="ColorOnAccent">#0B120E</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#3DDC84</Color>
            <Color x:Key="ColorWarning">#F5A623</Color>
            <Color x:Key="ColorError">#E63946</Color>
            <Color x:Key="ColorInfo">#4A90E2</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#E8F3EC</Color>
            <Color x:Key="ColorContentBackground">#F8FCF9</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceElevated">#F0FAF4</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#C8E3D4</Color>
            <Color x:Key="ColorStrokeWeak">#E0F0E8</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#12301F</Color>
            <Color x:Key="ColorTextSecondary">#3A5748</Color>
            <Color x:Key="ColorTextTertiary">#5C7D6B</Color>
            <Color x:Key="ColorTextDisabled">#8FAA9C</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#F0FAF4</Color>
            <Color x:Key="ColorPressed">#DDF2E6</Color>
            <Color x:Key="ColorSelected">#F8FCF9</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#17783F</Color>
            <Color x:Key="ColorAccentHover">#1A8D4A</Color>
            <Color x:Key="ColorAccentPressed">#126334</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#17783F</Color>
            <Color x:Key="ColorWarning">#D68910</Color>
            <Color x:Key="ColorError">#C7263E</Color>
            <Color x:Key="ColorInfo">#2E6FBD</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
