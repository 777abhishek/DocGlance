<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Rose Palette - Pink/rose theme  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#14080D</Color>
            <Color x:Key="ColorContentBackground">#22101A</Color>
            <Color x:Key="ColorSurface">#2F1823</Color>
            <Color x:Key="ColorSurfaceElevated">#3D202D</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#4D2838</Color>
            <Color x:Key="ColorStrokeWeak">#382030</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#FDEAF0</Color>
            <Color x:Key="ColorTextSecondary">#E7BFD0</Color>
            <Color x:Key="ColorTextTertiary">#D194B0</Color>
            <Color x:Key="ColorTextDisabled">#B46990</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#291420</Color>
            <Color x:Key="ColorPressed">#361A2A</Color>
            <Color x:Key="ColorSelected">#22101A</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#FF5C8A</Color>
            <Color x:Key="ColorAccentHover">#FF76A0</Color>
            <Color x:Key="ColorAccentPressed">#E64774</Color>
            <Color x:Key="ColorOnAccent">#14080D</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#34D399</Color>
            <Color x:Key="ColorWarning">#FBBF24</Color>
            <Color x:Key="ColorError">#FB7185</Color>
            <Color x:Key="ColorInfo">#60A5FA</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#FCE9EF</Color>
            <Color x:Key="ColorContentBackground">#FFF8FA</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceElevated">#FFF1F5</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#F9D0DF</Color>
            <Color x:Key="ColorStrokeWeak">#FCE5EC</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#4A1229</Color>
            <Color x:Key="ColorTextSecondary">#7D2E4F</Color>
            <Color x:Key="ColorTextTertiary">#B04A75</Color>
            <Color x:Key="ColorTextDisabled">#D4799E</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#FFF1F5</Color>
            <Color x:Key="ColorPressed">#FFE0EA</Color>
            <Color x:Key="ColorSelected">#FFF8FA</Color>
            
            <!-- Accent -->
            <Color x:Key="ColorAccent">#D6336C</Color>
            <Color x:Key="ColorAccentHover">#E04580</Color>
            <Color x:Key="ColorAccentPressed">#B72858</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#10B981</Color>
            <Color x:Key="ColorWarning">#F59E0B</Color>
            <Color x:Key="ColorError">#FB7185</Color>
            <Color x:Key="ColorInfo">#3B82F6</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
