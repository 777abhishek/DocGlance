<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Midnight Palette (Current Dark Theme)
          Pure black frame with #202020 content areas  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Frame and structure -->
            <Color x:Key="ColorFrameBackground">#000000</Color>
            <Color x:Key="ColorContentBackground">#202020</Color>
            <Color x:Key="ColorSurface">#2A2A2A</Color>
            <Color x:Key="ColorSurfaceElevated">#323232</Color>
            
            <!-- Strokes and dividers -->
            <Color x:Key="ColorStroke">#3A3A3A</Color>
            <Color x:Key="ColorStrokeWeak">#2A2A2A</Color>
            
            <!-- Text -->
            <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
            <Color x:Key="ColorTextSecondary">#B0B0B0</Color>
            <Color x:Key="ColorTextTertiary">#808080</Color>
            <Color x:Key="ColorTextDisabled">#606060</Color>
            
            <!-- Interactive states -->
            <Color x:Key="ColorHover">#2C2C2C</Color>
            <Color x:Key="ColorPressed">#383838</Color>
            <Color x:Key="ColorSelected">#202020</Color>
            
            <!-- Accent (follows system) -->
            <Color x:Key="ColorAccent">#0078D4</Color>
            <Color x:Key="ColorAccentHover">#106EBE</Color>
            <Color x:Key="ColorAccentPressed">#005A9E</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <!-- Semantic colors -->
            <Color x:Key="ColorSuccess">#10B981</Color>
            <Color x:Key="ColorWarning">#F59E0B</Color>
            <Color x:Key="ColorError">#EF4444</Color>
            <Color x:Key="ColorInfo">#3B82F6</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Light variant uses same structure -->
            <Color x:Key="ColorFrameBackground">#FFFFFF</Color>
            <Color x:Key="ColorContentBackground">#F2F2F2</Color>
            <Color x:Key="ColorSurface">#FAFAFA</Color>
            <Color x:Key="ColorSurfaceElevated">#FFFFFF</Color>
            
            <Color x:Key="ColorStroke">#E0E0E0</Color>
            <Color x:Key="ColorStrokeWeak">#F0F0F0</Color>
            
            <Color x:Key="ColorTextPrimary">#000000</Color>
            <Color x:Key="ColorTextSecondary">#606060</Color>
            <Color x:Key="ColorTextTertiary">#909090</Color>
            <Color x:Key="ColorTextDisabled">#B0B0B0</Color>
            
            <Color x:Key="ColorHover">#F5F5F5</Color>
            <Color x:Key="ColorPressed">#E8E8E8</Color>
            <Color x:Key="ColorSelected">#F2F2F2</Color>
            
            <Color x:Key="ColorAccent">#0078D4</Color>
            <Color x:Key="ColorAccentHover">#106EBE</Color>
            <Color x:Key="ColorAccentPressed">#005A9E</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <Color x:Key="ColorSuccess">#10B981</Color>
            <Color x:Key="ColorWarning">#F59E0B</Color>
            <Color x:Key="ColorError">#EF4444</Color>
            <Color x:Key="ColorInfo">#3B82F6</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
