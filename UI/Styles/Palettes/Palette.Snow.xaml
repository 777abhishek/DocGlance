<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Snow Palette (Clean Light Theme)
          Pure white frame with subtle gray content  -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="ColorFrameBackground">#FFFFFF</Color>
            <Color x:Key="ColorContentBackground">#F8F9FA</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceElevated">#FFFFFF</Color>
            
            <Color x:Key="ColorStroke">#DEE2E6</Color>
            <Color x:Key="ColorStrokeWeak">#F1F3F5</Color>
            
            <Color x:Key="ColorTextPrimary">#212529</Color>
            <Color x:Key="ColorTextSecondary">#495057</Color>
            <Color x:Key="ColorTextTertiary">#6C757D</Color>
            <Color x:Key="ColorTextDisabled">#ADB5BD</Color>
            
            <Color x:Key="ColorHover">#F8F9FA</Color>
            <Color x:Key="ColorPressed">#E9ECEF</Color>
            <Color x:Key="ColorSelected">#F8F9FA</Color>
            
            <Color x:Key="ColorAccent">#0D6EFD</Color>
            <Color x:Key="ColorAccentHover">#0B5ED7</Color>
            <Color x:Key="ColorAccentPressed">#0A58CA</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <Color x:Key="ColorSuccess">#198754</Color>
            <Color x:Key="ColorWarning">#FFC107</Color>
            <Color x:Key="ColorError">#DC3545</Color>
            <Color x:Key="ColorInfo">#0DCAF0</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ColorFrameBackground">#212529</Color>
            <Color x:Key="ColorContentBackground">#2B3035</Color>
            <Color x:Key="ColorSurface">#343A40</Color>
            <Color x:Key="ColorSurfaceElevated">#3D4349</Color>
            
            <Color x:Key="ColorStroke">#495057</Color>
            <Color x:Key="ColorStrokeWeak">#343A40</Color>
            
            <Color x:Key="ColorTextPrimary">#F8F9FA</Color>
            <Color x:Key="ColorTextSecondary">#DEE2E6</Color>
            <Color x:Key="ColorTextTertiary">#ADB5BD</Color>
            <Color x:Key="ColorTextDisabled">#6C757D</Color>
            
            <Color x:Key="ColorHover">#353B41</Color>
            <Color x:Key="ColorPressed">#404449</Color>
            <Color x:Key="ColorSelected">#2B3035</Color>
            
            <Color x:Key="ColorAccent">#0D6EFD</Color>
            <Color x:Key="ColorAccentHover">#3D8BFD</Color>
            <Color x:Key="ColorAccentPressed">#0A58CA</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>
            
            <Color x:Key="ColorSuccess">#198754</Color>
            <Color x:Key="ColorWarning">#FFC107</Color>
            <Color x:Key="ColorError">#DC3545</Color>
            <Color x:Key="ColorInfo">#0DCAF0</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
