<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest  —  QuickView MSIX package identity for Microsoft Store submission.

  BEFORE SUBMITTING TO THE STORE, replace the placeholder values below:
    Identity Name        → the Package/Identity Name from Partner Center
    Identity Publisher   → the Publisher CN= from Partner Center (e.g. CN=XXXXXXXX-XXXX-...)
    PhoneIdentity        → generate with: New-Guid in PowerShell (or leave Partner Center default)

  Everything else (DisplayName, Description, file associations) is production-ready.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="mp uap3 uap10 rescap">

  <!-- ═══════════════════════════════════════════════════════════════
       IDENTITY  —  fill in from Partner Center before submission
       ═══════════════════════════════════════════════════════════════ -->
  <Identity
    Name="PLACEHOLDER.QuickView"
    Publisher="CN=PLACEHOLDER"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity
    PhoneProductId="00000000-0000-0000-0000-000000000000"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <!-- ═══════════════════════════════════════════════════════════════
       PROPERTIES
       ═══════════════════════════════════════════════════════════════ -->
  <Properties>
    <DisplayName>QuickView</DisplayName>
    <PublisherDisplayName>QuickView Contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on" />
    </uap10:PackageIntegrity>
  </Properties>

  <!-- ═══════════════════════════════════════════════════════════════
       DEPENDENCIES — minimum Windows 10 2004 (build 19041)
       ═══════════════════════════════════════════════════════════════ -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- ═══════════════════════════════════════════════════════════════
       RESOURCES
       ═══════════════════════════════════════════════════════════════ -->
  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <!-- ═══════════════════════════════════════════════════════════════
       APPLICATION
       ═══════════════════════════════════════════════════════════════ -->
  <Applications>
    <Application
      Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">

      <uap:VisualElements
        DisplayName="QuickView"
        Description="Fast document viewer for PDF, PowerPoint, Word, and Excel"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          ShortName="QuickView">

        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:LockScreen Notification="badge" BadgeLogo="Assets\BadgeLogo.png" />
      </uap:VisualElements>

      <!-- ─────────────────────────────────────────────────────────
           EXTENSIONS
           ───────────────────────────────────────────────────────── -->
      <Extensions>

        <!-- FILE TYPE ASSOCIATIONS
             QuickView supports PDF, PowerPoint, Word, and Excel files
             using Rust-based rendering via PDFCraft, DeckCraft, WordCraft, and GridCraft -->
        
        <!-- PDF files (PDFCraft) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="quickview-pdf">
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>PDF Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\PDF.png</uap:Logo>
            <uap:InfoTip>Open with QuickView</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>
        
        <!-- PowerPoint files (DeckCraft) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="quickview-pptx">
            <uap:SupportedFileTypes>
              <uap:FileType>.pptx</uap:FileType>
              <uap:FileType>.ppt</uap:FileType>
              <uap:FileType>.pptm</uap:FileType>
              <uap:FileType>.ppsx</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>PowerPoint Presentation</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\PowerPoint.png</uap:Logo>
            <uap:InfoTip>Open with QuickView</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>
        
        <!-- Word files (WordCraft - coming soon) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="quickview-word">
            <uap:SupportedFileTypes>
              <uap:FileType>.docx</uap:FileType>
              <uap:FileType>.doc</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Word Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Word.png</uap:Logo>
            <uap:InfoTip>Open with QuickView</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>
        
        <!-- Excel files (GridCraft - coming soon) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="quickview-excel">
            <uap:SupportedFileTypes>
              <uap:FileType>.xlsx</uap:FileType>
              <uap:FileType>.xls</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Excel Spreadsheet</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Excel.png</uap:Logo>
            <uap:InfoTip>Open with QuickView</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

      </Extensions>
    </Application>
  </Applications>

  <!-- ═══════════════════════════════════════════════════════════════
       CAPABILITIES

       broadFileSystemAccess — required so the user can open files
         from anywhere (Downloads, Documents, network shares, custom
         paths typed directly). Without this, the packaged app can
         only see files the user explicitly picked via a file picker.
         The Store requires justification: "Users open arbitrary files
         via Explorer context menu / drag-and-drop / command line."

       internetClient — required for the update checker (GitHub API).

       Note: broadFileSystemAccess is a restricted capability that
       receives extra scrutiny during Store certification. The review
       team will check that it is genuinely needed (it is — file
       viewer opening arbitrary user-selected files).
       ═══════════════════════════════════════════════════════════════ -->
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>

</Package>

