<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest  —  DocGlance MSIX package identity for Microsoft Store submission.

  Store identity reserved in Partner Center. The signing certificate must
  match the Store publisher before building the Store package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="mp uap3 uap10 rescap">

  <!-- ═══════════════════════════════════════════════════════════════
       IDENTITY  —  Store product identity
       ═══════════════════════════════════════════════════════════════ -->
  <Identity
    Name="777abhishek.DocGlance"
    Publisher="CN=BBE5B101-6F9F-4DD1-B36A-16425B608E84"
    Version="20.10.26.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity
    PhoneProductId="00000000-0000-0000-0000-000000000000"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <!-- ═══════════════════════════════════════════════════════════════
       PROPERTIES
       ═══════════════════════════════════════════════════════════════ -->
  <Properties>
    <DisplayName>DocGlance</DisplayName>
    <PublisherDisplayName>777abhishek</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on" />
    </uap10:PackageIntegrity>
  </Properties>

  <!-- ═══════════════════════════════════════════════════════════════
       DEPENDENCIES — minimum Windows 10 2004 (build 19041)
       ═══════════════════════════════════════════════════════════════ -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- ═══════════════════════════════════════════════════════════════
       RESOURCES
       ═══════════════════════════════════════════════════════════════ -->
  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <!-- ═══════════════════════════════════════════════════════════════
       APPLICATION
       ═══════════════════════════════════════════════════════════════ -->
  <Applications>
    <Application
      Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">

      <uap:VisualElements
        DisplayName="DocGlance"
        Description="Fast document and image viewer for PDF, PowerPoint, Word, Excel, and images"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          ShortName="DocGlance">

        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:LockScreen Notification="badge" BadgeLogo="Assets\BadgeLogo.png" />
      </uap:VisualElements>

      <!-- ─────────────────────────────────────────────────────────
           EXTENSIONS
           ───────────────────────────────────────────────────────── -->
      <Extensions>

        <!-- FILE TYPE ASSOCIATIONS
             DocGlance supports PDF, PowerPoint, Word, and Excel files
             using Rust-based rendering via PDFCraft, DeckCraft, WordCraft, and GridCraft -->

        <!-- PDF files (PDFCraft) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-pdf">
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>PDF Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\PDF.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Common bitmap image files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-image">
            <uap:SupportedFileTypes>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.dds</uap:FileType>
              <uap:FileType>.hdp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jxr</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
              <uap:FileType>.svgz</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.wdp</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Image File</uap:DisplayName>
            <uap:Logo>Assets\StoreLogo.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- PowerPoint files (DeckCraft) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-pptx">
            <uap:SupportedFileTypes>
              <uap:FileType>.pptx</uap:FileType>
              <uap:FileType>.ppt</uap:FileType>
              <uap:FileType>.pptm</uap:FileType>
              <uap:FileType>.ppsx</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>PowerPoint Presentation</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\PowerPoint.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Word documents: separate associations so both extensions get the Word icon. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-docx">
            <uap:SupportedFileTypes>
              <uap:FileType>.docx</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Word Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Word.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-doc">
            <uap:SupportedFileTypes>
              <uap:FileType>.doc</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Word Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Word.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Excel files (GridCraft - coming soon) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-excel">
            <uap:SupportedFileTypes>
              <uap:FileType>.xlsx</uap:FileType>
              <uap:FileType>.xls</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Excel Spreadsheet</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Excel.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Text files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-text">
            <uap:SupportedFileTypes>
              <uap:FileType>.txt</uap:FileType>
              <uap:FileType>.log</uap:FileType>
              <uap:FileType>.ini</uap:FileType>
              <uap:FileType>.cfg</uap:FileType>
              <uap:FileType>.conf</uap:FileType>
              <uap:FileType>.env</uap:FileType>
              <uap:FileType>.properties</uap:FileType>
              <uap:FileType>.gitignore</uap:FileType>
              <uap:FileType>.editorconfig</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Text Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Text.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- CSV/TSV files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-csv">
            <uap:SupportedFileTypes>
              <uap:FileType>.csv</uap:FileType>
              <uap:FileType>.tsv</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>CSV File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\CSV.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Markdown files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-markdown">
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.mdx</uap:FileType>
              <uap:FileType>.mmd</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Markdown Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Markdown.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Rich Text files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-rtf">
            <uap:SupportedFileTypes>
              <uap:FileType>.rtf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Rich Text Document</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\RichText.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Code files - C# and .NET -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-code-csharp">
            <uap:SupportedFileTypes>
              <uap:FileType>.cs</uap:FileType>
              <uap:FileType>.vb</uap:FileType>
              <uap:FileType>.fs</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Code File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Code files - JavaScript/TypeScript -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-code-js">
            <uap:SupportedFileTypes>
              <uap:FileType>.js</uap:FileType>
              <uap:FileType>.mjs</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.tsx</uap:FileType>
              <uap:FileType>.jsx</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>JavaScript/TypeScript Code</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Code files - Python -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-code-python">
            <uap:SupportedFileTypes>
              <uap:FileType>.py</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Python Code</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Code files - Other languages -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-code-other">
            <uap:SupportedFileTypes>
              <uap:FileType>.java</uap:FileType>
              <uap:FileType>.kt</uap:FileType>
              <uap:FileType>.cpp</uap:FileType>
              <uap:FileType>.c</uap:FileType>
              <uap:FileType>.h</uap:FileType>
              <uap:FileType>.go</uap:FileType>
              <uap:FileType>.rs</uap:FileType>
              <uap:FileType>.swift</uap:FileType>
              <uap:FileType>.rb</uap:FileType>
              <uap:FileType>.php</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Code File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Script files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-scripts">
            <uap:SupportedFileTypes>
              <uap:FileType>.sh</uap:FileType>
              <uap:FileType>.ps1</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Script File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Web files - HTML/CSS -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-web">
            <uap:SupportedFileTypes>
              <uap:FileType>.html</uap:FileType>
              <uap:FileType>.htm</uap:FileType>
              <uap:FileType>.css</uap:FileType>
              <uap:FileType>.scss</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Web File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- JSON files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-json">
            <uap:SupportedFileTypes>
              <uap:FileType>.json</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>JSON File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\JSON.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- XML files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-xml">
            <uap:SupportedFileTypes>
              <uap:FileType>.xml</uap:FileType>
              <uap:FileType>.xaml</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>XML File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\XML.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- YAML/TOML files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-config">
            <uap:SupportedFileTypes>
              <uap:FileType>.yaml</uap:FileType>
              <uap:FileType>.yml</uap:FileType>
              <uap:FileType>.toml</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Configuration File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Text.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- SQL files -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="docglance-sql">
            <uap:SupportedFileTypes>
              <uap:FileType>.sql</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>SQL File</uap:DisplayName>
            <uap:Logo>Assets\FileTypeIcons\Code.png</uap:Logo>
            <uap:InfoTip>Open with DocGlance</uap:InfoTip>
          </uap:FileTypeAssociation>
        </uap:Extension>

      </Extensions>
    </Application>
  </Applications>

  <!-- ═══════════════════════════════════════════════════════════════
       CAPABILITIES

       internetClient — required for the update checker (GitHub API).
       User documents and folders are accessed only after the user
       selects them through the file/folder picker or opens them through
       Windows file activation.
       ═══════════════════════════════════════════════════════════════ -->
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
